()\n    if isinstance(value, date):\n        return value\n    try:\n        return datetime.strptime(str(value)[:10], \"%Y-%m-%d\").date()\n    except (ValueError, TypeError):\n        return None\n\n\nclass VideoAnalyticsService:\n    \"\"\"\n    Service Layer untuk Video Analytics.\n\n    Seluruh workflow Video Analytics berada di class ini.\n    Router cukup memanggil .index(creator_id) dan merender template.\n    \"\"\"\n\n    def index(self, ...[truncated]", "content_numbered": "1: \"\"\"\n2: Video Analytics Service Layer.\n3: \n4: Service Layer yang menangani seluruh business logic Video Analytics.\n5: Router hanya memanggil fungsi di module ini dan merender template.\n6: \n7: Tanggung Jawab:\n8:     - Menerima creator_id dari Router\n9:     - Mengambil data creator (validasi)\n10:     - Membaca data analytics dari database (jika tersedia)\n11:     - Membentuk object yang siap digunakan template\n12:     - Mengembalikan object ke Router\n13: \n14: TIDAK menangani:\n15:     - Scraping TikTok\n16:     - Update Analytics\n17:     - INSERT/UPDATE/DELETE database\n18:     - Background job\n19: \"\"\"\n20: \n21: from datetime import datetime, timedelta, date\n22: from includes.mysql import get_connection, get_creator\n23: from includes.mysql import upsert_tiktok_video, upsert_video_daily_stats\n24: from includes.tiktok_scrape_videos import TikTokScraper\n25: from includes.logFX import logger, INFO, WARNING, ERROR\n26: \n27: # ==============================\n28: # KONSTANTA LOG PREFIX\n29: # ==============================\n30: LOG_PREFIX = \"[VideoAnalytics]\"\n31: \n32: \n33: def _as_date(value):\n34:     \"\"\"\n35:     Normalisasi nilai snapshot_time (datetime / date / str) menjadi objek date.\n36: \n37:     Dipakai untuk menentukan apakah sebuah snapshot berasal dari HARI INI,\n38:     supaya definisi \"Perubahan Hari Ini\" pada summary konsisten dengan\n39:     semantik tanggal yang dipakai daily views chart (DATE(snapshot_time)).\n40: \n41:     Args:\n42:     