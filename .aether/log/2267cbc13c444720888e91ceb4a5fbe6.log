{"timestamp": "2026-09-23T16:33:10.212749+00:00", "task_id": "2267cbc13c444720888e91ceb4a5fbe6", "event": "observation_received", "data": {"tool": "read_file", "tool_call_id": "call_03_eLFPyEeGdWNxiCp66CH50368", "success": true, "content": {"path": "includes/logFX.py", "total_lines": 28, "content": "from colorama import Fore, Style, init\nfrom includes.config_loader import get_app_config\n\n# Inisialisasi colorama\ninit(autoreset=True)\nconfig = get_app_config()\n\n# Level\nINFO = \"info\"\nWARNING = \"warning\"\nERROR = \"error\"\nLOG = \"log\"\nDEBUG = \"debug\"\n\n\ndef logger(level, message):\n    if config[\"debug\"] == True :\n        colors = {\n            INFO: Fore.LIGHTCYAN_EX,      # Biru muda\n            WARNING: Fore.LIGHTYELLOW_EX, # Kuning\n            ERROR: Fore.LIGHTRED_EX,      # Merah\n            LOG: Fore.WHITE,              # Putih\n            DEBUG: Fore.LIGHTMAGENTA_EX,  # Ungu muda\n        }\n\n        color = colors.get(level.lower(), Fore.WHITE)\n\n        print(f\"{color}[{level.upper()}]{Style.RESET_ALL} {message}\")"}}}
