 class=\"col-md-4\">\n\n                    <input\n                        type=\"time\"\n                        class=\"form-control upload-time-item\"\n                        value=\"${time}\"\n                        onchange=\"updateUploadTime(${index}, this.value)\">\n\n                </div>\n\n                <div class=\"col-md-auto\">\n\n                    <button\n                        type=\"button\"\n                        class=\"btn btn-danger\"\n                        onclick=\"removeUploadTime(${index})\">\n\n                        <i class=\"ti ti-trash me-1\"></i>\n\n                        Remove\n\n                    </button>\n\n                </div>\n\n            </div>\n\n        `;\n\n    });\n\n}\n\nfunction updateUploadTime(index, value) {\n\n    uploadTimes[index] = value;\n\n    uploadTimes.sort();\n\n    renderUploadTimes();\n\n}\n\nfunction removeUploadTime(index) {\n\n    uploadTimes.splice(index, 1);\n\n    renderUploadTimes();\n\n}\n\nfunction sendFixedSchedule() {\n\n    if (uploadTimes.length === 0) {\n        alert(\"Tambahkan minimal satu jam upload.\");\n        return;\n    }\n\n    const uploadDirectory = document\n    .getElementById(\"upload_directory\")\n    .value\n    .trim();\n\n    if(uploadDirectory === \"\"){\n\n        alert(\"Silakan isi Upload Directory.\");\n\n        document.getElementById(\"upload_directory\").focus();\n\n        return;\n\n    }\n\n    const startDate = document.getElementById(\"fixed_start_date\").value;\n    if(!startDate){\n        alert(\"Silakan pilih Start Date.\");\n        document.getElementById(\"fixed_start_date\").focus();\n        return;\n    }\n\n    // Cek creator dulu baru submit\n    checkCreatorAndSubmit(function() {\n\n        const formData = new FormData();\n\n        formData.append(\"schedule_mode\", \"fixed\");\n        formData.append(\"distribution_method\", getDistributionMethod());\n        formData.append(\"products\", JSON.stringify(selectedProducts));\n        formData.append(\"upload_directory\", document.getElementById(\"upload_directory\").value.trim());\n        formData.append(\"start_date\", startDate);\n        formData.append(\"upload_times\", JSON.stringify(uploadTimes));\n\n        submitFormWithFetch(formData);\n\n    });\n\n}\n\n// ==============================\n// SAVE / LOAD FIXED TIME SETTINGS\n// ==============================\n\nfunction getFixedSaveConfig() {\n\n    return {\n        upload_times: uploadTimes.slice()\n    };\n\n}\n\nfunction saveFixedSettings() {\n\n    downloadScheduleSettings(\"fixed\", getFixedSaveConfig());\n\n}\n\nfunction applyFixedSettings(cfg) {\n\n    cfg = cfg || {};\n\n    uploadTimes = Array.isArray(cfg.upload_times) ? cfg.upload_times.slice() : [];\n    uploadTimes.sort();\n\n    renderUploadTimes();\n\n}\n\n</script>", "content_numbered": "60:                     Add Time\n61: \n62:                 </button>\n63: \n64:             </div>\n65: \n66:         </div>\n67: \n68:         <hr>\n69: \n70:         <div id=\"uploadTimeList\">\n71: \n72:             <div class=\"text-secondary\">\n73: \n74:                 No upload time added.\n75: \n76:             </div>\n77: \n78:         </div>\n79: \n80:         <hr>\n81: \n82:         <div class=\"d-flex justify-content-end\">\n83: \n84:             <button\n85:                 type=\"button\"\n86:                 class=\"btn btn-outline-primary me-2\"\n87:                 onclick=\"saveFixedSettings()\">\n88: \n89:                 <i class=\"ti ti-device-floppy me-2\"></i>\n90:                 Save\n91: \n92:             </button>\n93: \n94:             <button\n95:                 class=\"btn btn-primary\"\n96:                 onclick=\"sendFixedSchedule()\">\n97: \n98:                 Next\n99: \n100:                 <i class=\"ti ti-arrow-right ms-2\"></i>\n101: \n102:             </button>\n103: \n104:         </div>\n105: \n106:     </div>\n107: \n108: </div>\n109: <script>\n110: let uploadTimes = [];\n111: \n