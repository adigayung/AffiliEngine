edSettings() {\n259: \n260:     downloadScheduleSettings(\"fixed\", getFixedSaveConfig());\n261: \n262: }\n263: \n264: function applyFixedSettings(cfg) {\n265: \n266:     cfg = cfg || {};\n267: \n268:     uploadTimes = Array.isArray(cfg.upload_times) ? cfg.upload_times.slice() : [];\n269:     uploadTimes.sort();\n270: \n271:     renderUploadTimes();\n272: \n273: }\n274: \n275: </script>"}}}
