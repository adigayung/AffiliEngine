s.value);\n    });\n});\n\nfunction submitWeeklySchedule(){\n\n    const uploadDirectory = document\n    .getElementById(\"upload_directory\")\n    .value\n    .trim();\n\n    if(uploadDirectory === \"\"){\n\n        alert(\"Silakan isi Upload Directory.\");\n\n        document.getElementById(\"upload_directory\").focus();\n\n        return;\n\n    }\n\n    const startDate = document.getElementById(\"weekly_start_date\").value;\n    if(!startDate){\n        alert(\"Silakan pilih Start Date.\");\n        document.getElementById(\"weekly_start_date\").focus();\n        return;\n    }\n\n    console.log(\"WEEKLY:\", weeklySchedule);\n\n    // Cek creator dulu baru submit\n    checkCreatorAndSubmit(function() {\n\n        const formData = new FormData();\n\n        formData.append(\"schedule_mode\", \"weekly\");\n        formData.append(\"distribution_method\", getDistributionMethod());\n        formData.append(\"products\", JSON.stringify(selectedProducts));\n        formData.append(\"upload_directory\", document.getElementById(\"upload_directory\").value.trim());\n        formData.append(\"start_date\", startDate);\n        formData.append(\"weekly_schedule\", JSON.stringify(weeklySchedule));\n\n        submitFormWithFetch(formData);\n\n    });\n\n}\n\n// ==============================\n// SAVE / LOAD WEEKLY SETTINGS\n// ==============================\n\nfunction getWeeklySaveConfig() {\n\n    return {\n        weekly_schedule: JSON.parse(JSON.stringify(weeklySchedule))\n    };\n\n}\n\nfunction saveWeeklySettings() {\n\n    downloadScheduleSettings(\"weekly\", getWeeklySaveConfig());\n\n}\n\nfunction applyWeeklySettings(cfg) {\n\n    cfg = cfg || {};\n\n    var schedule = cfg.weekly_schedule || {};\n\n    Object.keys(weeklySchedule).forEach(function(day) {\n\n        var times = Array.isArray(schedule[day]) ? schedule[day].slice() : [];\n        times.sort();\n        weeklySchedule[day] = times;\n        renderWeekly(day);\n\n    });\n\n}\n\n</script>", "content_numb