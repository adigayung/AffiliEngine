eIdx) {\n\n            timesHtml +=\n                '<span class=\"time-badge badge bg-dark text-white me-1 mb-1\" ' +\n                'style=\"cursor:pointer;\" ' +\n                'onclick=\"openTimeEditor(\\'' + section + '\\', ' + dayIdx + ', ' + timeIdx + ')\" ' +\n                'title=\"Klik untuk mengedit\">' +\n                '<i class=\"ti ti-clock-edit me-1\"></i>' +\n                time +\n                '</span>';\n\n        });"}, "error": null}}
