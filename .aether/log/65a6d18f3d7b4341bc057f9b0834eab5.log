ElementById('repeatStatusBadge');\n    if (p.repeat_count > 0) {\n        badge.textContent = 'Berulang ' + p.repeat_count + 'x ' +\n            (p.repeat_every_days === 1 ? 'setiap hari' : 'setiap ' + p.repeat_every_days + ' hari');\n    } else {\n        badge.textContent = 'Tidak berulang';\n    }\n\n}\n\n// ==============================\n// PATTERN EDITOR\n// ==============================\n\nfunction renderPatternEditor() {\n\n    renderInitialPatternEditor();\n    renderRepeatPatternEditor();\n\n}\n\nfunction renderInitialPatternEditor() {\n\n    const container = document.getElementById('initialPatternDays');\n    container.innerHTML = '';\n\n    if (!importState.initialPattern || importState.initialPattern.length === 0) {\n\n        container.innerHTML = '<div class=\"col-12 text-secondary py-3 text-center\">' +\n            '<i class=\"ti ti-minus me-1\"></i> Tidak ada initial pattern</div>';\n        return;\n    }\n\n    importState.initialPattern.forEach(function(day, dayIdx) {\n\n        const dayCard = createDayEditorCard(day, dayIdx, 'initial');\n        container.appendChild(dayCard);\n\n    });\n\n}\n\nfunction renderRepeatPatternEditor() {\n\n    const container = document.getElementById('repeatPatternDays');\n    container.innerHTML = '';\n\n    if (!importState.repeatPattern || importState.repeatPattern.length === 0) {\n\n        container.inne...[truncated]"}, "metadata": {"tool": "read_file"}}}
