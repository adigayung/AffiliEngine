{"timestamp": "2026-10-10T16:06:33.619310+00:00", "task_id": "65a6d18f3d7b4341bc057f9b0834eab5", "event": "agent_observation", "data": {"action_id": "call_01_ET_XKOIJjW5VXcwgO5SuOdI8880", "success": true, "error": null, "content": {"path": "templates/product_list/tabs/pattern.html", "total_lines": 576, "content": "﻿<div class=\"card border-0\">\n\n    <div class=\"card-body\">\n\n        <h3 class=\"mb-3\">\n            Upload Pattern Strategy\n        </h3>\n\n        <p class=\"text-secondary mb-4\">\n\n            Gabungkan beberapa strategi upload menjadi satu workflow.\n            Setiap stage akan dijalankan secara berurutan hingga seluruh video selesai.\n\n        </p>\n\n        <div class=\"row mb-4\">\n\n            <div class=\"col-md-4\">\n\n                <label class=\"form-label\">\n                    Start Date\n                </label>\n\n                <input\n                    id=\"pattern_start_date\"\n                    type=\"date\"\n                    class=\"form-control\">\n\n            </div>\n\n        </div>\n\n        <div class=\"d-flex justify-content-end mb-4\">\n\n            <button\n                id=\"btnAddStage\"\n                type=\"button\"\n                class=\"btn btn-primary\"\n                onclick=\"addStage()\">\n\n                <i class=\"ti ti-plus me-2\"></i>\n\n                Add Stage\n\n            </button>\n\n        </div>\n\n        <div id=\"patternStages\">\n\n            <!-- Stages will be rendered by JavaScript -->\n\n        </div>\n\n        <hr>\n\n        <div class=\"d-flex justify-content-end\">\n\n            <button\n                id=\"btnNext\"\n                type=\"button\"\n                class=\"btn btn-primary\"\n                onclick=\"submitPattern()\">\n\n                Next\n\n                <i class=\"ti ti-arrow-right ms-2\"></i>\n\n            </button>\n\n        </div>\n\n    </div>\n\n</div>\n\n<script>\nlet stages = [];\nlet stageCounter = 0;\n\nfunction addStage() {\n    stageCounter++;\n    const stage = {\n        id: stageCounter,\n        duration: 7,\n        unit: 'days',\n        strategy: 'interval',\n        config: {\n            interval_hour: 24,\n            interval_minute: 0\n        }\n    };\n    stages.push(stage);\n    renderStages();\n}\n\nfunction deleteStage(stageId) {\n    stages = stages.filter(function(s) { return s.id !== stageId; });\n    stageCounter = stages.length;\n    renderStages();\n}\n\nfunction renderStages() {\n    const container = document.getElementById('patternStages');\n    container.innerHTML = '';\n\n    stages.forEach(function(stage, index) {\n        const stageNum = index + 1;\n        const strategy = stage.strategy;\n\n        const stageHtml = `\n            <div class=\"card mb-3\" data-stage-id=\"${stage.id}\">\n                <div class=\"card-header\">\n                    <strong>\n                        Stage ${stageNum}\n                    </strong>\n                </div>\n                <div class=\"card-body\">\n                    <div class=\"row\">\n                        <div class=\"col-md-3\">\n                            <label class=\"form-label\">\n                                Duration\n                            </label>\n                            <input\n                                type=\"number\"\n                                class=\"form-control stage-duration\"\n                                value=\"${stage.duration}\"\n                                data-stage-id=\"${stage.id}\"\n                                onchange=\"updateStageDuration(${stage.id}, this.value)\">\n                        </div>\n                        <div class=\"col-md-3\">\n                            <label class=\"form-label\">\n                                Unit\n                            </label>\n                            <select class=\"form-select stage-unit\"\n                                data-stage-id=\"${stage.id}\"\n                                onchange=\"updateStageUnit(${stage.id}, this.value)\">\n                                <option value=\"days\" ${stage.unit === 'days' ? 'selected' : ''}>Days</option>\n                                <option value=\"weeks\" ${stage.unit === 'weeks' ? 'selected' : ''}>Weeks</option>\n                                <option value=\"months\" ${stage.unit === 'months' ? 'selected' : ''}>Months</option>\n                                <option value=\"until_finish\" ${stage.unit === 'until_finish' ? 'selected' : ''}>Until Finish</option>\n                            </select>\n                        </div>\n                        <div class=\"col-md-4\">\n                            <label class=\"form-label\">\n                                Upload Strategy\n                            </label>\n                            <select class=\"form-select stage-strategy\"\n                                data-stage-id=\"${stage.id}\"\n                                onchange=\"updateStageStrategy(${stage.id}, this.value)\">\n                                <option value=\"interval\" ${strategy === 'interval' ? 'selected' : ''}>Interval</option>\n                                <option value=\"fixed\" ${strategy === 'fixed' ? 'selected' : ''}>Fixed Time</option>\n                                <option value=\"weekly\" ${strategy === 'weekly' ? 'selected' : ''}>Weekly</option>\n                            </select>\n                        </div>\n                        <div class=\"col-md-2 d-flex align-items-end\">\n                            <button type=\"button\" class=\"btn btn-danger w-100\" onclick=\"deleteStage(${stage.id})\">\n                                Delete\n                            </button>\n                        </div>\n                    </div>\n                    <hr>\n                    <div class=\"strategy-config\" data-stage-id=\"${stage.id}\">\n                        ${getStrategyConfigHTML(stage)}\n                    </div>\n                </div>\n            </div>\n        `;\n\n        container.innerHTML += stageHtml;\n    });\n\n    if (stages.length === 0) {\n        container.innerHTML = `\n            <div class=\"text-secondary text-center py-4\">\n                No stages added yet. Click \"Add Stage\" to begin.\n            </div>\n        `;\n    }\n}\n\nfunction getStrategyConfigHTML(stage) {\n    const strategy = stage.strategy;\n    const config = stage.config;\n\n    if (strategy === 'interval') {\n        return `\n            <div class=\"row\">\n                <div class=\"col-md-4\">\n                    <label class=\"form-label\">\n                        Interval Hour\n                    </label>\n                    <input\n                        type=\"number\"\n                        class=\"form-control\"\n                        value=\"${config.interval_hour || 24}\"\n                        min=\"1\"\n                        onchange=\"updateStageConfig(${stage.id}, 'interval_hour', this.value)\">\n                </div>\n                <div class=\"col-md-4\">\n                    <label class=\"form-label\">\n                        Interval Minute\n                    </label>\n                    <input\n                        type=\"number\"\n                        class=\"form-control\"\n                        value=\"${config.interval_minute || 0}\"\n                        min=\"0\"\n                        max=\"59\"\n                        onchange=\"updateStageConfig(${stage.id}, 'interval_minute', this.value)\">\n                </div>\n            </div>\n        `;\n    }\n\n    if (strategy === 'fixed') {\n        const times = config.times || [];\n        let timesHtml = '';\n        times.forEach(function(time, idx) {\n            timesHtml += `\n                <div class=\"row align-items-end mb-2\">\n                    <div class=\"col-md-4\">\n                        <input\n                            type=\"time\"\n                            class=\"form-control\"\n                            value=\"${time}\"\n                            onchange=\"updateFixedTime(${stage.id}, ${idx}, this.value)\">\n                    </div>\n                    <div class=\"col-md-auto\">\n                        <button\n                            type=\"button\"\n                            class=\"btn btn-danger\"\n                            onclick=\"removeFixedTime(${stage.id}, ${idx})\">\n                            <i class=\"ti ti-trash me-1\"></i>\n                            Remove\n                        </button>\n                    </div>\n                </div>\n            `;\n        });\n\n        return `\n            <div class=\"row align-items-end mb-2\">\n                <div class=\"col-md-4\">\n                    <label class=\"form-label\">\n                        Upload Time\n                    </label>\n                    <input\n                        type=\"time\"\n                        class=\"form-control\"\n                        id=\"fixedTimeInput_${stage.id}\">\n                </div>\n                <div class=\"col-md-auto\">\n                    <button\n                        type=\"button\"\n                        class=\"btn btn-primary\"\n                        onclick=\"addFixedTime(${stage.id})\">\n                        <i class=\"ti ti-plus me-1\"></i>\n                        Add Time\n                    </button>\n                </div>\n            </div>\n            <div id=\"fixedTimeList_${stage.id}\">\n                ${timesHtml || '<div class=\"text-secondary\">No upload time added.</div>'}\n            </div>\n        `;\n    }\n\n    if (strategy === 'weekly') {\n        const dayNames = ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'];\n        const dayNameId = { Monday:'Senin', Tuesday:'Selasa', Wednesday:'Rabu', Thursday:'Kamis', Friday:'Jumat', Saturday:'Sabtu', Sunday:'Minggu' };\n        const schedule = config.schedule || {};\n\n        // Tentukan jumlah hari yang ditampilkan (hanya untuk unit=days)\n        var startDateVal = document.getElementById('pattern_start_date').value;\n        var displayCount = 7; // default: tampilkan 7 hari\n        if (stage.unit === 'days') {\n            var dur = parseInt(stage.duration);\n            if (!isNaN(dur) && dur > 0 && dur < 7) {\n                displayCount = dur;\n            }\n        }\n\n        // Tentukan urutan hari berdasarkan start date\n        var dayOrderForRender = [];\n        if (startDateVal) {\n            var startDayIndex = new Date(startDateVal).getDay(); // 0=Minggu, 1=Senin, ...\n            var jsDayToIndex = [6, 0, 1, 2, 3, 4, 5];\n            var offset = jsDayToIndex[startDayIndex];\n            for (var di = 0; di < displayCount; di++) {\n                dayOrderForRender.push(dayNames[(di + offset) % 7]);\n            }\n        } else {\n            // Jika start date belum dipilih, tampilkan Monday..Sunday\n            for (var di = 0; di < displayCount; di++) {\n                dayOrderForRender.push(dayNames[di]);\n            }\n        }\n\n        let weeklyHtml = '';\n        dayOrderForRender.forEach(function(day) {\n            const dayTimes = schedule[day] || [];\n            let badgesHtml = '';\n            if (dayTimes.length > 0) {\n                dayTimes.forEach(function(time) {\n                    badgesHtml += `\n                        <span class=\"badge bg-primary text-white me-2 mb-2\">\n                            ${time}\n                            <a href=\"#\"\n                                class=\"text-white text-decoration-none ms-2\"\n                                onclick=\"removeWeeklyTimeStage(${stage.id}, '${day}', '${time}');return false;\">\n                                ×\n                            </a>\n                        </span>\n                    `;\n                });\n            } else {\n                badgesHtml = '<span class=\"text-secondary\">No upload schedule.</span>';\n            }\n\n            weeklyHtml += `\n                <div class=\"card mb-2\">\n                    <div class=\"card-body py-2\">\n                        <div class=\"row align-items-end\">\n                            <div class=\"col-md-2\">\n                                <h5 class=\"mb-0\">${dayNameId[day]}</h5>\n                            </div>\n                            <div class=\"col-md-3\">\n                                <input\n                                    type=\"time\"\n                                    class=\"form-control\"\n                                    id=\"weeklyTimeInput_${stage.id}_${day.toLowerCase()}\">\n                            </div>\n                            <div class=\"col-md-auto\">\n                                <button\n                                    type=\"button\"\n                                    class=\"btn btn-primary\"\n                                    onclick=\"addWeeklyTimeStage(${stage.id}, '${day}')\">\n                                    <i class=\"ti ti-plus me-1\"></i>\n                                    Add\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"mt-2\" id=\"weeklyTimeList_${stage.id}_${day.toLowerCase()}\">\n                            ${badgesHtml}\n                        </div>\n                    </div>\n                </div>\n            `;\n        });\n\n        return weeklyHtml;\n    }\n\n    return '<div class=\"text-secondary\">Strategy configuration will appear here.</div>';\n}\n\n// Stage data update functions\n\nfunction updateStageDuration(stageId, value) {\n    const stage = stages.find(function(s) { return s.id === stageId; });\n    if (stage) {\n        stage.duration = value;\n        // Re-render if weekly strategy (duration affects number of day cards)\n        if (stage.strategy === 'weekly') {\n            renderStages();\n        }\n    }\n}\n\nfunction updateStageUnit(stageId, value) {\n    const stage = stages.find(function(s) { return s.id === stageId; });\n    if (stage) {\n        stage.unit = value;\n        // If unit is until_finish, duration doesn't matter but we keep it\n        if (value === 'until_finish') {\n            stage.duration = 'until_finish';\n        }\n        renderStages();\n    }\n}\n\nfunction updateStageStrategy(stageId, value) {\n    const stage = stages.find(function(s) { return s.id === stageId; });\n    if (stage) {\n        stage.strategy = value;\n        // Initialize default config based on strategy\n        if (value === 'interval') {\n            stage.config = { interval_hour: 24, interval_minute: 0 };\n        } else if (value === 'fixed') {\n            stage.config = { times: [] };\n        } else if (value === 'weekly') {\n            stage.config = {\n                schedule: {\n                    Monday: [],\n                    Tuesday: [],\n                    Wednesday: [],\n                    Thursday: [],\n                    Friday: [],\n                    Saturday: [],\n                    Sunday: []\n                }\n            };\n        }\n        renderStages();\n    }\n}\n\nfunction updateStageConfig(stageId, key, value) {\n    const stage = stages.find(function(s) { return s.id === stageId; });\n    if (stage) {\n        stage.config[key] = parseFloat(value);\n    }\n}\n\n// Fixed time functions for a stage\n\nfunction addFixedTime(stageId) {\n    const input = document.getElementById('fixedTimeInput_' + stageId);\n    const time = input.value;\n\n    if (!time) {\n        alert('Pilih jam upload.');\n        return;\n    }\n\n    const stage = stages.find(function(s) { return s.id === stageId; });\n    if (!stage) return;\n\n    if (!stage.config.times) {\n        stage.config.times = [];\n    }\n\n    if (stage.config.times.includes(time)) {\n        alert('Jam sudah ada.');\n        return;\n    }\n\n    stage.config.times.push(time);\n    stage.config.times.sort();\n    input.value = '';\n    renderStages();\n}\n\nfunction removeFixedTime(stageId, index) {\n    const stage = stages.find(function(s) { return s.id === stageId; });\n    if (stage && stage.config.times) {\n        stage.config.times.splice(index, 1);\n        renderStages();\n    }\n}\n\n// Weekly functions for a stage\n\nfunction addWeeklyTimeStage(stageId, day) {\n    const input = document.getElementById('weeklyTimeInput_' + stageId + '_' + day.toLowerCase());\n    const time = input.value;\n\n    if (!time) {\n        alert('Pilih jam upload.');\n        return;\n    }\n\n    const stage = stages.find(function(s) { return s.id === stageId; });\n    if (!stage) return;\n\n    if (!stage.config.schedule) {\n        stage.config.schedule = {\n            Monday: [], Tuesday: [], Wednesday: [], Thursday: [],\n            Friday: [], Saturday: [], Sunday: []\n        };\n    }\n\n    if (stage.config.schedule[day].includes(time)) {\n        alert('Jam sudah ada.');\n        return;\n    }\n\n    stage.config.schedule[day].push(time);\n    stage.config.schedule[day].sort();\n    input.value = '';\n    renderStages();\n}\n\nfunction removeWeeklyTimeStage(stageId, day, time) {\n    const stage = stages.find(function(s) { return s.id === stageId; });\n    if (stage && stage.config.schedule && stage.config.schedule[day]) {\n        stage.config.schedule[day] = stage.config.schedule[day].filter(function(t) {\n            return t !== time;\n        });\n        renderStages();\n    }\n}\n\n// Submit function\n\nfunction submitPattern() {\n    if (stages.length === 0) {\n        alert('Tambahkan minimal satu stage.');\n        return;\n    }\n\n    const uploadDirectory = document.getElementById('upload_directory').value.trim();\n    if (uploadDirectory === '') {\n        alert('Silakan isi Upload Directory.');\n        document.getElementById('upload_directory').focus();\n        return;\n    }\n\n    const startDate = document.getElementById('pattern_start_date').value;\n    if (!startDate) {\n        alert('Silakan pilih Start Date.');\n        document.getElementById('pattern_start_date').focus();\n        return;\n    }\n\n    // Build patternData array\n    const patternData = [];\n    stages.forEach(function(stage) {\n        const item = {\n            duration: stage.duration,\n            unit: stage.unit,\n            strategy: stage.strategy,\n            config: {}\n        };\n\n        if (stage.strategy === 'interval') {\n            item.config = {\n                interval_hour: parseInt(stage.config.interval_hour) || 0,\n                interval_minute: parseInt(stage.config.interval_minute) || 0\n            };\n        } else if (stage.strategy === 'fixed') {\n            item.config = {\n                times: stage.config.times || []\n            };\n        } else if (stage.strategy === 'weekly') {\n            item.config = {\n                Monday: stage.config.schedule ? stage.config.schedule.Monday || [] : [],\n                Tuesday: stage.config.schedule ? stage.config.schedule.Tuesday || [] : [],\n                Wednesday: stage.config.schedule ? stage.config.schedule.Wednesday || [] : [],\n                Thursday: stage.config.schedule ? stage.config.schedule.Thursday || [] : [],\n                Friday: stage.config.schedule ? stage.config.schedule.Friday || [] : [],\n                Saturday: stage.config.schedule ? stage.config.schedule.Saturday || [] : [],\n                Sunday: stage.config.schedule ? stage.config.schedule.Sunday || [] : []\n            };\n        }\n\n        patternData.push(item);\n    });\n\n    // Cek creator dulu baru submit\n    checkCreatorAndSubmit(function() {\n\n        const formData = new FormData();\n\n        formData.append('schedule_mode', 'pattern');\n        formData.append('distribution_method', getDistributionMethod());\n        formData.append('products', JSON.stringify(selectedProducts));\n        formData.append('upload_directory', document.getElementById('upload_directory').value.trim());\n        formData.append('start_date', startDate);\n        formData.append('pattern', JSON.stringify(patternData));\n\n        submitFormWithFetch(formData);\n\n    });\n}\n\n// Initialize with one default stage\ndocument.addEventListener('DOMContentLoaded', function() {\n    addStage();\n    // Re-render when start date changes (affects weekly day order)\n    document.getElementById('pattern_start_date').addEventListener('change', function() {\n        renderStages();\n    });\n});\n</script>\n"}, "metadata": {"tool": "read_file"}}}
