{"timestamp": "2026-10-10T16:06:33.616310+00:00", "task_id": "65a6d18f3d7b4341bc057f9b0834eab5", "event": "tool_result", "data": {"tool": "read_file", "tool_call_id": "call_00_ET_qvxvpYynQMhmTlpOwbWK5046", "success": true, "status": "success", "output": {"path": "templates/product_list/tabs/weekly.html", "total_lines": 394, "content": "<div class=\"card border-0\">\n\n    <div class=\"card-body\">\n\n        <h3 class=\"mb-3\">\n            Weekly Upload Schedule\n        </h3>\n\n        <p class=\"text-secondary mb-4\">\n            Atur jam upload berbeda untuk setiap hari dalam seminggu.\n            Jadwal ini akan diulang terus hingga seluruh video selesai di-upload.\n        </p>\n\n\n        <div class=\"row mb-4\">\n\n            <div class=\"col-md-4\">\n\n                <label class=\"form-label\">\n                    Start Date\n                </label>\n\n                <input\n                    type=\"date\"\n                    class=\"form-control\"\n                    id=\"weekly_start_date\">\n\n            </div>\n\n        </div>\n\n\n        {% set days = [\n            ('Monday', 'Senin'),\n            ('Tuesday', 'Selasa'),\n            ('Wednesday', 'Rabu'),\n            ('Thursday', 'Kamis'),\n            ('Friday', 'Jumat'),\n            ('Saturday', 'Sabtu'),\n            ('Sunday', 'Minggu')\n        ] %}\n\n\n        {% for day_en, day_id in days %}\n\n        <div \n            class=\"card mb-3 weekly-day\"\n            data-day=\"{{ day_en }}\"\n        >\n\n            <div class=\"card-body\">\n\n\n                <div class=\"row align-items-end\">\n\n\n                    <div class=\"col-md-2\">\n\n                        <h4 class=\"mb-0\">\n\n                            {{ day_id }}\n\n                        </h4>\n\n                    </div>\n\n\n\n                    <div class=\"col-md-3\">\n\n\n                        <label class=\"form-label\">\n\n                            Upload Time\n\n                        </label>\n\n\n                        <input\n                                                        type=\"time\"\n                            class=\"form-control\"\n                            id=\"{{ day_en|lower }}_time\">\n\n\n                    </div>\n\n\n\n                    <div class=\"col-md-auto\">\n\n\n                        <button\n                            type=\"button\"\n                            class=\"btn btn-primary\"\n                            onclick=\"addWeeklyTime('{{ day_en }}')\">\n\n\n                            <i class=\"ti ti-plus me-1\"></i>\n\n                            Add\n\n\n                        </button>\n\n\n                    </div>\n\n\n                </div>\n\n\n\n                <div\n                    id=\"{{ day_en|lower }}_list\"\n                    class=\"mt-3 weekly-time-list\">\n\n\n                    <span class=\"text-secondary\">\n\n                        No upload schedule.\n\n                    </span>\n\n\n                </div>\n\n\n\n            </div>\n\n\n        </div>\n\n\n        {% endfor %}\n\n\n\n        <hr>\n\n\n        <div class=\"d-flex justify-content-end\">\n\n\n            <button\n                id=\"btnNext\"\n                type=\"button\"\n                class=\"btn btn-primary\"\n                onclick=\"submitWeeklySchedule()\">\n\n\n                Next\n\n\n                <i class=\"ti ti-arrow-right ms-2\"></i>\n\n\n            </button>\n\n\n        </div>\n\n\n    </div>\n\n\n</div>\n\n<script>\nconst weeklySchedule = {\n\n    Monday: [],\n\n    Tuesday: [],\n\n    Wednesday: [],\n\n    Thursday: [],\n\n    Friday: [],\n\n    Saturday: [],\n\n    Sunday: []\n\n};\n\n\nfunction addWeeklyTime(day){\n\n    day = day.charAt(0).toUpperCase() + day.slice(1);\n\n    const input = document.getElementById(\n        day.toLowerCase() + \"_time\"\n    );\n\n    const value = input.value;\n\n    if(!value){\n\n        alert(\"Pilih jam upload.\");\n\n        return;\n\n    }\n\n    if(weeklySchedule[day].includes(value)){\n\n        alert(\"Jam sudah ada.\");\n\n        return;\n\n    }\n\n    weeklySchedule[day].push(value);\n\n    weeklySchedule[day].sort();\n\n    input.value = \"\";\n\n    renderWeekly(day);\n\n}\n\n\nfunction removeWeeklyTime(day,time){\n\n    weeklySchedule[day] = weeklySchedule[day].filter(\n\n        t => t !== time\n\n    );\n\n    renderWeekly(day);\n\n}\n\n\nfunction renderWeekly(day){\n\n    const div = document.getElementById(\n\n        day.toLowerCase() + \"_list\"\n\n    );\n\n    const list = weeklySchedule[day];\n\n    if(list.length===0){\n\n        div.innerHTML = `\n\n            <span class=\"text-secondary\">\n\n                No upload schedule.\n\n            </span>\n\n        `;\n\n        return;\n\n    }\n\n    let html = \"\";\n\n    list.forEach(time=>{\n\n        html += `\n\n        <span class=\"badge bg-primary text-white me-2 mb-2\">\n            ${time}\n\n            <a\n                href=\"#\"\n                class=\"text-white text-decoration-none ms-2\"\n                onclick=\"removeWeeklyTime('${day}','${time}');return false;\">\n\n                ×\n\n            </a>\n\n        </span>\n\n        `;\n\n    });\n\n    div.innerHTML = html;\n\n}\n\nvar dayNameMapId = {\n    Monday: 'Senin',\n    Tuesday: 'Selasa',\n    Wednesday: 'Rabu',\n    Thursday: 'Kamis',\n    Friday: 'Jumat',\n    Saturday: 'Sabtu',\n    Sunday: 'Minggu'\n};\n\nvar dayOrderEn = [\n    'Monday', 'Tuesday', 'Wednesday',\n    'Thursday', 'Friday', 'Saturday', 'Sunday'\n];\n\nfunction reorderWeekDays(startDateValue){\n\n    if(!startDateValue) return;\n\n    // Parent sebenarnya dari semua .weekly-day\n    var parent = document.querySelector(\".weekly-day\").parentElement;\n    var cards = Array.prototype.slice.call(\n        parent.querySelectorAll(\".weekly-day\")\n    );\n    if(cards.length !== 7) return;\n\n    var startDayIndex = new Date(startDateValue).getDay();\n    var jsDayToIndex = [6, 0, 1, 2, 3, 4, 5];\n    var offset = jsDayToIndex[startDayIndex];\n\n    // Bangun urutan baru berdasarkan offset\n    var newOrder = [];\n    for(var i = 0; i < 7; i++){\n        var targetDayEn = dayOrderEn[(i + offset) % 7];\n        for(var j = 0; j < 7; j++){\n            if(cards[j].getAttribute(\"data-day\") === targetDayEn){\n                newOrder.push(cards[j]);\n                break;\n            }\n        }\n    }\n\n    // Pindahkan card ke urutan baru\n    for(var i = 0; i < newOrder.length; i++){\n        parent.appendChild(newOrder[i]);\n    }\n}\n\ndocument.addEventListener(\"DOMContentLoaded\", function(){\n    var startDateInput = document.getElementById(\"weekly_start_date\");\n    if(startDateInput.value){\n        reorderWeekDays(startDateInput.value);\n    }\n    startDateInput.addEventListener(\"change\", function(){\n        reorderWeekDays(this.value);\n    });\n});\n\nfunction submitWeeklySchedule(){\n\n    const uploadDirectory = document\n    .getElementById(\"upload_directory\")\n    .value\n    .trim();\n\n    if(uploadDirectory === \"\"){\n\n        alert(\"Silakan isi Upload Directory.\");\n\n        document.getElementById(\"upload_directory\").focus();\n\n        return;\n\n    }\n\n    const startDate = document.getElementById(\"weekly_start_date\").value;\n    if(!startDate){\n        alert(\"Silakan pilih Start Date.\");\n        document.getElementById(\"weekly_start_date\").focus();\n        return;\n    }\n\n    console.log(\"WEEKLY:\", weeklySchedule);\n\n    // Cek creator dulu baru submit\n    checkCreatorAndSubmit(function() {\n\n        const formData = new FormData();\n\n        formData.append(\"schedule_mode\", \"weekly\");\n        formData.append(\"distribution_method\", getDistributionMethod());\n        formData.append(\"products\", JSON.stringify(selectedProducts));\n        formData.append(\"upload_directory\", document.getElementById(\"upload_directory\").value.trim());\n        formData.append(\"start_date\", startDate);\n        formData.append(\"weekly_schedule\", JSON.stringify(weeklySchedule));\n\n        submitFormWithFetch(formData);\n\n    });\n\n}\n</script>\n"}, "error": null}}
