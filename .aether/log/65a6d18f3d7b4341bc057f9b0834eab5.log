iginal Pattern\n\n                    </button>\n                </div>\n\n                <button\n                    id=\"btnGenerate\"\n                    type=\"button\"\n                    class=\"btn btn-success\"\n                    onclick=\"generateFromImport()\"\n                    disabled>\n\n                    <i class=\"ti ti-player-play me-2\"></i>\n                    Next\n\n                </button>\n\n            </div>\n\n        </div>\n\n    </div>\n\n</div>\n\n<!-- ============================== -->\n<!-- TIME EDITOR MODAL -->\n<!-- ============================== -->\n<div class=\"modal modal-sm fade\" id=\"timeEditorModal\" tabindex=\"-1\">\n\n    <div class=\"modal-dialog\">\n\n        <div class=\"modal-content\">\n\n            <div class=\"modal-header\">\n\n                <h5 class=\"modal-title\">\n                    <i class=\"ti ti-clock-edit me-2\"></i>\n                    Edit Upload Time\n                </h5>\n\n                <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\"></button>\n\n            </div>\n\n            <div class=\"modal-body\">\n\n                <input type=\"hidden\" id=\"editTimeSection\" value=\"\">\n                <input type=\"hidden\" id=\"editTimeDayIdx\" value=\"\">\n                <input type=\"hidden\" id=\"editTimeIdx\" value=\"\">\n\n                <label class=\"form-label\">\n                    Hour : Minute\n                </label>\n\n                <div class=\"input-group\">\n\n                    <span class=\"input-group-text\">\n                        <i class=\"ti ti-clock\"></i>\n                    </span>\n\n                    <input\n                        id=\"editTimeInput\"\n                        type=\"time\"\n                        class=\"form-control\"\n                        step=\"60\">\n\n                </div>\n\n            </div>\n\n            <div class=\"modal-footer\">\n\n                <button type=\"button\" class=\"btn bt