klySchedule[day].includes(value)){\n\n        alert(\"Jam sudah ada.\");\n\n        return;\n\n    }\n\n    weeklySchedule[day].push(value);\n\n    weeklySchedule[day].sort();\n\n    input.value = \"\";\n\n    renderWeekly(day);\n\n}\n\n\nfunction removeWeeklyTime(day,time){\n\n    weeklySchedule[day] = weeklySchedule[day].filter(\n\n        t => t !== time\n\n    );\n\n    renderWeekly(day);\n\n}\n\n\nfunction renderWeekly(day){\n\n    const div = document.getElementById(\n\n        day.toLowerCase() + \"_list\"\n\n    );\n\n    const list = weeklySchedule[day];\n\n    if(list.length===0){\n\n        div.innerHTML = `\n\n            <span class=\"text-secondary\">\n\n                No upload schedule.\n\n            </span>\n\n        `;\n\n        return;\n\n    }\n\n    let html = \"\";\n\n    list.forEach(time=>{\n\n        html += `\n\n        <span class=\"badge bg-primary text-white me-2 mb-2\">\n            ${time}\n\n            <a\n                href=\"#\"\n                class=\"text-white text-decoration-none ms-2\"\n                onclick=\"removeWeeklyTime('${day}','${time}');return false;\">\n\n                ×\n\n            </a>\n\n        </span>\n\n        `;\n\n    });\n\n    div.innerHTML = html;\n\n}\n\nvar dayNameMapId = {\n    Monday: 'Senin',\n    Tuesday: 'Selasa',\n    Wednesday: 'Rabu',\n    Thursday: 'Kamis',\n    Friday: 'Jumat',\n    Saturday: 'Sabtu',\n    Sunday: 'Minggu'\n};\n\nvar dayOrderEn = [\n    'Monday', 'Tuesday', 'Wednesday',\n    'Thursday', 'Friday', 'Saturday', 'Sunday'\n];\n\nfunction reorderWeekDays(startDateValue){\n\n    if(!startDateValue) return;\n\n    // Parent sebenarnya dari semua .weekly-day\n    var parent = document.querySelector(\".weekly-day\").parentElement;\n    var cards = Array.prototype.slice.call(\n        parent.querySelectorAll(\".weekly-day\")\n    );\n    if(cards.length !== 7) return;\n\n    var startDayIndex = new Date(startDateValue).getDay();\n    var jsDayToIndex = [6, 0, 1, 2, 3, 4, 5