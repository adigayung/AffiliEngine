electorAll(sel) {\n    if (sel.indexOf(\"distribution_method\") !== -1) return radios;\n    return [];\n  },\n  createElement() { return makeEl(); },\n  body: makeEl(),\n  addEventListener() {},\n  open() {}, write() {}, close() {},\n};\n\nlet lastDownload = { json: null, filename: null, href: null };\nclass FakeBlob {\n  constructor(parts, ...[truncated]", "path": "_validate_roundtrip.js"}, "target": "_validate_roundtrip.js", "iteration": 28}}
