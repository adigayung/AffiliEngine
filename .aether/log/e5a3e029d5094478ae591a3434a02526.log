f.logs.clear()\n        self.add_log(\n            f\"Scan dimulai untuk creator ID: {creator_id}\",\n            \"info\"\n        )\n\n        # Jalankan service di background thread\n        self._thread = threading.Thread(\n            target=self._run_scan_thread,\n            args=(creator_id,),\n            daemon=True,\n        )\n        self._thread.start()\n        return {\n            \"success\": True,\n            \"message\": \"Scan dimulai.\"\n        }\n\n    de...[truncated]"}}}
