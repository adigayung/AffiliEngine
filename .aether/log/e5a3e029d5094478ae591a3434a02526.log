nd j[\"creator_id\"] == creator_id\n            ]\n            self._single = match[0] if match else None\n        elif norm.startswith(\"DELETE FROM upload_jobs\"):\n            creator_id = params[0]\n            if \"status = 'pending'\" in norm:\n                ids = set(params[1:])\n                self.store[\"jobs\"] = [\n                    j\n                    for j in self.store[\"jobs\"]\n                    if not (\n              ...[truncated]"}}}
