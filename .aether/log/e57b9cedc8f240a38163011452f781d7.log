{"timestamp": "2026-10-04T05:41:17.737466+00:00", "task_id": "e57b9cedc8f240a38163011452f781d7", "event": "observation_received", "data": {"tool": "read_file", "tool_call_id": "call_01_Eb5VXmcGKIKRk6PVL53h8109", "success": true, "content": {"path": "includes/video_pipeline/audio_normalize.py", "start_line": 540, "end_line": 690, "total_lines": 730, "content": "\ndef normalize_video_file(\n    input_path,\n    output_path=None,\n    target_i=DEFAULT_TARGET,\n    target_tp=DEFAULT_TRUE_PEAK,\n    target_lra=DEFAULT_LRA,\n    nr_amount=DEFAULT_NR,\n    log_callback=None,\n):\n    \"\"\"Normalize the audio of a media file, callable from other modules.\n\n    This is the *library* entry point used by the video pipeline\n    (``includes/video_pipeline/processor.py``). It wraps :func:`normalize` so\n    that no ``sys.exit`` ever reaches the caller: failures are logged and\n    reported as ``None`` so the pipeline can continue with the original file.\n\n    Args:\n        input_path: Path file video/audio input (mp4) yang akan dinormalisasi.\n        output_path: Path output. Jika None, memakai ``<input>_normalized<ext>``.\n        target_i: Target integrated loudness (LUFS).\n        target_tp: Target true peak (dBTP).\n        target_lra: Target loudness range (LU).\n        nr_amount: Noise reduction afftdn (dB) untuk jalur fallback.\n        log_callback: Optional callable(str) untuk meneruskan log ke UI.\n\n    Returns:\n        str path output normalisasi bila berhasil, atau ``None`` bila dilewati\n        (tidak ada audio / ffmpeg tidak tersedia) atau gagal.\n    \"\"\"\n    def _log(msg):\n        _emit(msg, log_callback)\n\n    input_path = str(input_path)\n\n    if not os.path.isfile(input_path):\n        _log(f\"[FAIL] Normalize audio: input tidak ditemukan: {input_path}\")\n        return None\n\n    # ffmpeg/ffprobe wajib; kalau tidak ada, jangan hentikan pipeline.\n    for cmd in (\"ffmpeg\", \"ffprobe\"):\n        if shutil.which(cmd) is None:\n            _log(f\"[WARN] Normalize audio: '{cmd}' tidak tersedia, dilewati\")\n            return None\n\n    if not has_audio(input_path):\n        _log(\"[SKIP] Normalize audio: tidak ada stream audio\")\n        return None\n\n    if output_path is None:\n        base, ext = os.path.splitext(input_path)\n        output_path = f\"{base}_normalized{ext}\"\n    output_path = str(output_path)\n\n    try:\n        input_i, total_gain_lu, enhance_used = normalize(\n            input_path,\n            output_path,\n            target_i=target_i,\n            target_tp=target_tp,\n            target_lra=target_lra,\n            nr_amount=nr_amount,\n            log_callback=log_callback,\n        )\n    except AudioNormalizeError as exc:\n        _log(f\"[FAIL] Normalize audio gagal: {exc}\")\n        return None\n    except Exception as exc:  # defensive: jangan crash-kan pipeline\n        logger.exception(\"Normalize audio error for %s\", input_path)\n        _log(f\"[FAIL] Normalize audio error: {exc}\")\n        return None\n\n    if os.path.isfile(output_path) and os.path.getsize(output_path) > 0:\n        sign = \"+\" if total_gain_lu >= 0 else \"\"\n        logger.info(\n            \"Normalize audio: %s -> %s (%.1f LUFS -> %.1f LUFS, %s%.1f dB, \"\n            \"enhance=%s)\",\n            input_path,\n            output_path,\n            input_i,\n            target_i,\n            sign,\n            total_gain_lu,\n            enhance_used,\n        )\n        _log(\n            f\"[OK] Normalize audio: {input_i:.1f} LUFS -> {target_i:.1f} LUFS \"\n            f\"({sign}{total_gain_lu:.1f} dB)\"\n        )\n        return output_path\n\n    _log(\"[FAIL] Normalize audio: output tidak dihasilkan\")\n    return None\n\n\ndef main():\n    parser = argparse.ArgumentParser(\n        description=(\n            \"Enhance and normalize audio of video/audio files: voice enhancement \"\n            \"(noisereduce + Pedalboard) followed by two-pass EBU R128 loudness \"\n            \"normalization to a target integrated loudness level (LUFS).\"\n        )\n    )\n    parser.add_argument(\"input\", help=\"Input video or audio file\")\n    parser.add_argument(\n        \"-o\", \"--output\",\n        help=\"Output file path (default: <input>_normalized<ext>)\",\n    )\n    parser.add_argument(\n        \"--target\",\n        type=float,\n        default=DEFAULT_TARGET,\n        help=f\"Target integrated loudness in LUFS (default: {DEFAULT_TARGET})\",\n    )\n    parser.add_argument(\n        \"--nr\",\n        type=float,\n        default=DEFAULT_NR,\n        help=(\n            f\"Noise reduction amount in dB using afftdn (0=off, default: {DEFAULT_NR}). \"\n            \"The enhance stage already performs noise reduction, so afftdn is \"\n            \"skipped on the normal path; this value is used only when the \"\n            \"enhance backend is unavailable.\"\n        ),\n    )\n\n    args = parser.parse_args()\n\n    check_ffmpeg()\n\n    input_path = args.input\n\n    if not os.path.isfile(input_path):\n        print(f\"Error: Input file not found: {input_path}\", file=sys.stderr)\n        sys.exit(1)\n\n    if not has_audio(input_path):\n        print(f\"Error: No audio stream found in: {input_path}\", file=sys.stderr)\n        sys.exit(1)\n\n    # Enhance voice is part of the default pipeline -> deps must be available.\n    check_enhance_deps()\n\n    # Log dependency versions for diagnostics.\n    try:\n        import pedalboard as _pd\n        import noisereduce as _nr\n        _pd_ver = getattr(_pd, \"__version__\", \"?\")\n        _nr_ver = getattr(_nr, \"__version__\", \"?\")\n        print(f\"  Dependencies: pedalboard {_pd_ver}, noisereduce {_nr_ver}\")\n        print(f\"  Python: {sys.version.split()[0]}, FFmpeg pipeline: enhance + two-pass loudnorm\")", "content_numbered": "540: \n541: def normalize_video_file(\n542:     input_path,\n543:     output_path=None,\n544:     target_i=DEFAULT_TARGET,\n545:     target_tp=DEFAULT_TRUE_PEAK,\n546:     target_lra=DEFAULT_LRA,\n547:     nr_amount=DEFAULT_NR,\n548:     log_callback=None,\n549: ):\n550:     \"\"\"Normalize the audio of a media file, callable from other modules.\n551: \n552:     This is the *library* entry point used by the video pipeline\n553:     (``includes/video_pipeline/processor.py``). It wraps :func:`normalize` so\n554:     that no ``sys.exit`` ever reaches the caller: failures are logged and\n555:     reported as ``None`` so the pipeline can continue with the original file.\n556: \n557:     Args:\n558:         input_path: Path file video/audio input (mp4) yang akan dinormalisasi.\n559:         output_path: Path output. Jika None, memakai ``<input>_normalized<ext>``.\n560:         target_i: Target integrated loudness (LUFS).\n561:         target_tp: Target true peak (dBTP).\n562:         target_lra: Target loudness range (LU).\n563:         nr_amount: Noise reduction afftdn (dB) untuk jalur fallback.\n564:         log_callback: Optional callable(str) untuk meneruskan log ke UI.\n565: \n566:     Returns:\n567:         str path output normalisasi bila berhasil, atau ``None`` bila dilewati\n568:         (tidak ada audio / ffmpeg tidak tersedia) atau gagal.\n569:     \"\"\"\n570:     def _log(msg):\n571:         _emit(msg, log_callback)\n572: \n573:     input_path = str(input_path)\n574: \n575:     if not os.path.isfile(input_path):\n576:         _log(f\"[FAIL] Normalize audio: input tidak ditemukan: {input_path}\")\n577:         return None\n578: \n579:     # ffmpeg/ffprobe wajib; kalau tidak ada, jangan hentikan pipeline.\n580:     for cmd in (\"ffmpeg\", \"ffprobe\"):\n581:         if shutil.which(cmd) is None:\n582:             _log(f\"[WARN] Normalize audio: '{cmd}' tidak tersedia, dilewati\")\n583:             return None\n584: \n585:     if not has_audio(input_path):\n586:         _log(\"[SKIP] Normalize audio: tidak ada stream audio\")\n587:         return None\n588: \n589:     if output_path is None:\n590:         base, ext = os.path.splitext(input_path)\n591:         output_path = f\"{base}_normalized{ext}\"\n592:     output_path = str(output_path)\n593: \n594:     try:\n595:         input_i, total_gain_lu, enhance_used = normalize(\n596:             input_path,\n597:             output_path,\n598:             target_i=target_i,\n599:             target_tp=target_tp,\n600:             target_lra=target_lra,\n601:             nr_amount=nr_amount,\n602:             log_callback=log_callback,\n603:         )\n604:     except AudioNormalizeError as exc:\n605:         _log(f\"[FAIL] Normalize audio gagal: {exc}\")\n606:         return None\n607:     except Exception as exc:  # defensive: jangan crash-kan pipeline\n608:         logger.exception(\"Normalize audio error for %s\", input_path)\n609:         _log(f\"[FAIL] Normalize audio error: {exc}\")\n610:         return None\n611: \n612:     if os.path.isfile(output_path) and os.path.getsize(output_path) > 0:\n613:         sign = \"+\" if total_gain_lu >= 0 else \"\"\n614:         logger.info(\n615:             \"Normalize audio: %s -> %s (%.1f LUFS -> %.1f LUFS, %s%.1f dB, \"\n616:             \"enhance=%s)\",\n617:             input_path,\n618:             output_path,\n619:             input_i,\n620:             target_i,\n621:             sign,\n622:             total_gain_lu,\n623:             enhance_used,\n624:         )\n625:         _log(\n626:             f\"[OK] Normalize audio: {input_i:.1f} LUFS -> {target_i:.1f} LUFS \"\n627:             f\"({sign}{total_gain_lu:.1f} dB)\"\n628:         )\n629:         return output_path\n630: \n631:     _log(\"[FAIL] Normalize audio: output tidak dihasilkan\")\n632:     return None\n633: \n634: \n635: def main():\n636:     parser = argparse.ArgumentParser(\n637:         description=(\n638:             \"Enhance and normalize audio of video/audio files: voice enhancement \"\n639:             \"(noisereduce + Pedalboard) followed by two-pass EBU R128 loudness \"\n640:             \"normalization to a target integrated loudness level (LUFS).\"\n641:         )\n642:     )\n643:     parser.add_argument(\"input\", help=\"Input video or audio file\")\n644:     parser.add_argument(\n645:         \"-o\", \"--output\",\n646:         help=\"Output file path (default: <input>_normalized<ext>)\",\n647:     )\n648:     parser.add_argument(\n649:         \"--target\",\n650:         type=float,\n651:         default=DEFAULT_TARGET,\n652:         help=f\"Target integrated loudness in LUFS (default: {DEFAULT_TARGET})\",\n653:     )\n654:     parser.add_argument(\n655:         \"--nr\",\n656:         type=float,\n657:         default=DEFAULT_NR,\n658:         help=(\n659:             f\"Noise reduction amount in dB using afftdn (0=off, default: {DEFAULT_NR}). \"\n660:             \"The enhance stage already performs noise reduction, so afftdn is \"\n661:             \"skipped on the normal path; this value is used only when the \"\n662:             \"enhance backend is unavailable.\"\n663:         ),\n664:     )\n665: \n666:     args = parser.parse_args()\n667: \n668:     check_ffmpeg()\n669: \n670:     input_path = args.input\n671: \n672:     if not os.path.isfile(input_path):\n673:         print(f\"Error: Input file not found: {input_path}\", file=sys.stderr)\n674:         sys.exit(1)\n675: \n676:     if not has_audio(input_path):\n677:         print(f\"Error: No audio stream found in: {input_path}\", file=sys.stderr)\n678:         sys.exit(1)\n679: \n680:     # Enhance voice is part of the default pipeline -> deps must be available.\n681:     check_enhance_deps()\n682: \n683:     # Log dependency versions for diagnostics.\n684:     try:\n685:         import pedalboard as _pd\n686:         import noisereduce as _nr\n687:         _pd_ver = getattr(_pd, \"__version__\", \"?\")\n688:         _nr_ver = getattr(_nr, \"__version__\", \"?\")\n689:         print(f\"  Dependencies: pedalboard {_pd_ver}, noisereduce {_nr_ver}\")\n690:         print(f\"  Python: {sys.version.spli