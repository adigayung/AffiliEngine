\n        if shutil.which(cmd) is None:\n            _log(f\"[WARN] Normalize audio: '{cmd}' tidak tersedia, dilewati\")\n            return None\n\n    if not has_audio(input_path):\n        _log(\"[SKIP] Normalize audio: tidak ada stream audio\")\n        return None\n\n    if output_path is None:\n  ...[truncated]", "old_text": "        return input_i, total_gain_lu, enhance_used\n    finally:\n        # Always clean up temporary WAV files, even on error.\n        shutil.rmtree(temp_dir, ignore_errors=True)\n\n\ndef main():", "path": "includes/video_pipeline/audio_normalize.py"}, "target": "includes/video_pipeline/audio_normalize.py", "iteration": 25}}
