{"timestamp": "2026-10-04T05:37:06.727464+00:00", "task_id": "e57b9cedc8f240a38163011452f781d7", "event": "tool_result", "data": {"tool": "read_file", "tool_call_id": "call_00_og1SU940DSxGK1FAgp961232", "success": true, "status": "success", "output": {"path": "includes/video_pipeline/audio_normalize.py", "total_lines": 594, "content": "#!/usr/bin/env python3\n\"\"\"normalize.py - Enhance and normalize audio of video/audio files using FFmpeg.\n\nDefault pipeline:\n    Input video/audio\n    → Extract audio to a temporary WAV at the *input* sample rate (FFmpeg)\n    → Enhance voice (noisereduce + Pedalboard)\n    → Two-pass EBU R128 loudness normalization + true-peak protection (FFmpeg)\n    → Output video/audio (video stream copied, audio re-encoded to AAC 192k)\n\nThe \"enhance voice\" stage uses the `pedalboard` and `noisereduce` Python\npackages and runs automatically as part of the standard pipeline. Because the\nenhance stage already performs noise reduction (noisereduce + NoiseGate),\nFFmpeg's `afftdn` is NOT applied on top of it (avoids double noise reduction /\nloss of detail).\n\nThe video stream is always copied without re-encoding, preserving resolution,\nframe rate, duration and A/V sync. The audio sample rate follows the input.\n\nUsage:\n    python normalize.py a.mp4\n    python normalize.py a.mp4 -o hasil.mp4\n    python normalize.py a.mp4 --target -14\n\"\"\"\n\nimport argparse\nimport json\nimport multiprocessing\nimport shutil\nimport subprocess\nimport sys\nimport os\nimport tempfile\n\n\nDEFAULT_TARGET = -14.0\nDEFAULT_TRUE_PEAK = -1.0\nDEFAULT_LRA = 11.0\n# afftdn noise reduction (dB) used only when the enhance backend is\n# unavailable. On the normal (enhance) path afftdn is skipped because the\n# enhance stage already reduces noise.\nDEFAULT_NR = 3\n\n\n# ---------------------------------------------------------------------------\n# Optional \"enhance voice\" dependencies (pedalboard + noisereduce).\n# Imported defensively so the CLI can still print --help / a clear error\n# instead of dumping a raw traceback when the packages are missing.\n# ---------------------------------------------------------------------------\ntry:\n    from pedalboard import (\n        NoiseGate,\n        Compressor,\n        LowShelfFilter,\n        HighShelfFilter,\n        HighpassFilter,\n        Pedalboard,\n    )\n    from pedalboard.io import AudioFile\n    import noisereduce as nr\n\n    _ENHANCE_IMPORT_ERROR = None\nexcept Exception as _exc:  # ImportError, or a numpy ABI mismatch, etc.\n    _ENHANCE_IMPORT_ERROR = _exc\n\n\ndef check_enhance_deps():\n    \"\"\"Fail with a clear, actionable message if enhance deps are unavailable.\"\"\"\n    if _ENHANCE_IMPORT_ERROR is not None:\n        print(\n            \"Error: the 'enhance voice' step requires the Python packages \"\n            \"'pedalboard' and 'noisereduce', but they could not be imported.\",\n            file=sys.stderr,\n        )\n        print(f\"       Detail: {_ENHANCE_IMPORT_ERROR}\", file=sys.stderr)\n        print(\"       Install them with:\", file=sys.stderr)\n        print(\n            f\"         {sys.executable} -m pip install pedalboard noisereduce\",\n            file=sys.stderr,\n        )\n        sys.exit(1)\n\n\ndef check_ffmpeg():\n    \"\"\"Ensure ffmpeg and ffprobe are available.\"\"\"\n    for cmd in (\"ffmpeg\", \"ffprobe\"):\n        if shutil.which(cmd) is None:\n            print(\n                f\"Error: '{cmd}' is not installed or not in PATH.\",\n                file=sys.stderr,\n            )\n            print(\n                \"Please install FFmpeg: https://ffmpeg.org/download.html\",\n                file=sys.stderr,\n            )\n            sys.exit(1)\n\n\ndef has_stream(filepath, stream_type):\n    \"\"\"Check if file has at least one stream of the given type ('a' or 'v').\"\"\"\n    cmd = [\n        \"ffprobe\",\n        \"-v\", \"error\",\n        \"-select_streams\", stream_type,\n        \"-show_entries\", \"stream=codec_type\",\n        \"-of\", \"csv=p=0\",\n        filepath,\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    return result.returncode == 0 and result.stdout.strip() != \"\"\n\n\ndef has_audio(filepath):\n    return has_stream(filepath, \"a\")\n\n\ndef has_video(filepath):\n    return has_stream(filepath, \"v\")\n\n\ndef get_audio_sample_rate(filepath):\n    \"\"\"Return the sample rate (int Hz) of the first audio stream, or None.\"\"\"\n    cmd = [\n        \"ffprobe\",\n        \"-v\", \"error\",\n        \"-select_streams\", \"a:0\",\n        \"-show_entries\", \"stream=sample_rate\",\n        \"-of\", \"default=noprint_wrappers=1:nokey=1\",\n        filepath,\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    if result.returncode != 0:\n        return None\n    out = result.stdout.strip()\n    if not out:\n        return None\n    try:\n        return int(float(out))\n    except ValueError:\n        return None\n\n\ndef extract_audio_wav(input_path, wav_path, sample_rate):\n    \"\"\"Extract the audio stream to a WAV file at the given sample rate.\"\"\"\n    cmd = [\n        \"ffmpeg\",\n        \"-y\",\n        \"-i\", input_path,\n        \"-vn\",\n        \"-acodec\", \"pcm_s16le\",\n        \"-ar\", str(int(sample_rate)),\n        wav_path,\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    if result.returncode != 0:\n        print(\n            \"Error: failed to extract audio to a temporary WAV file.\",\n            file=sys.stderr,\n        )\n        for line in result.stderr.strip().splitlines()[-10:]:\n            print(line, file=sys.stderr)\n        sys.exit(1)\n\n\ndef enhance_audio(raw_audio_path, enhanced_audio_path, sample_rate):\n    \"\"\"Enhance human voice in an audio file (noisereduce + Pedalboard).\n\n    Chain:\n        noisereduce.reduce_noise(stationary=True, prop_decrease=0.6)\n        -> Pedalboard [\n               HighpassFilter(80 Hz),                    # kill rumble below 80 Hz\n               NoiseGate(-38 dB, ratio 2.5, release 400 ms),\n               Compressor(-20 dB, ratio 2.5),\n               LowShelfFilter(300 Hz, +4 dB, q 1),       # gentle vocal lift\n               HighShelfFilter(1200 Hz, +1.5 dB, q 0.7),\n           ]\n\n    NOTE: The old fixed Gain(+13 dB) makeup is REMOVED. Loudness is handled by\n    the two-pass EBU R128 loudnorm stage, which is applied AFTER this chain.\n    A fixed +13 dB gain on top of loudnorm was amplifying the noise floor on\n    silent segments.\n\n    NoiseGate threshold was dropped to -38 dB (relative to a noise floor that\n    is itself much lower after noisereduce + high-pass) so that speech above\n    the (reduced) noise floor stays open while residual hiss on quiet segments\n    is suppressed. Gate runs BEFORE any make-up/level gain.\n\n    The input is read at `sample_rate` (which should be the file's own sample\n    rate, so no unnecessary resampling occurs) and the result is written back\n    at the same rate. Output is audio-only (no video).\n    \"\"\"\n    # === Read audio (keep the requested sample rate) ===\n    with AudioFile(raw_audio_path).resampled_to(sample_rate) as f:\n        audio = f.read(f.frames)\n        sr = f.samplerate\n\n    # === Noise reduction (stationary) ===\n    # noisereduce expects (channels, samples) for stereo; pedalboard's\n    # AudioFile.read() already returns (channels, samples), so this is safe.\n    reduced_noise = nr.reduce_noise(\n        y=audio, sr=sr, stationary=True, prop_decrease=0.6\n    )\n\n    # Chain WITHOUT fixed makeup gain. Loudness is set by loudnorm afterwards.\n    board = Pedalboard([\n        HighpassFilter(cutoff_frequency_hz=80),\n        NoiseGate(threshold_db=-38, ratio=2.5, release_ms=400),\n        Compressor(threshold_db=-20, ratio=2.5),\n        LowShelfFilter(cutoff_frequency_hz=300, gain_db=4, q=1),\n        HighShelfFilter(cutoff_frequency_hz=1200, gain_db=1.5, q=0.7),\n    ])\n\n    effected = board(reduced_noise, sr)\n\n    # === Write enhanced audio to file ===\n    with AudioFile(enhanced_audio_path, \"w\", sr, effected.shape[0]) as f:\n        f.write(effected)\n\n\ndef _enhance_child(raw_audio_path, enhanced_audio_path, sample_rate):\n    \"\"\"Child-process entry point that runs ``enhance_audio``.\n\n    Defined at module level so it can be pickled by the Windows 'spawn' start\n    method. A Python-level failure exits non-zero without dumping a raw\n    traceback; a native crash of pedalboard simply kills the child, which the\n    parent detects via the exit code.\n    \"\"\"\n    try:\n        enhance_audio(raw_audio_path, enhanced_audio_path, sample_rate)\n    except Exception as exc:  # defensive: keep the parent's output clean\n        sys.stderr.write(f\"enhance step failed: {exc}\\n\")\n        sys.stderr.flush()\n        os._exit(1)\n\n\ndef enhance_audio_isolated(raw_audio_path, enhanced_audio_path, sample_rate):\n    \"\"\"Run ``enhance_audio`` in a child process; return True on success.\n\n    The pedalboard/noisereduce call is native code that can crash the whole\n    interpreter on some systems. Running it in a child process lets the CLI\n    detect the failure (via the exit code) and degrade gracefully instead of\n    aborting with an access violation.\n    \"\"\"\n    try:\n        ctx = multiprocessing.get_context(\"spawn\")\n        proc = ctx.Process(\n            target=_enhance_child,\n            args=(raw_audio_path, enhanced_audio_path, sample_rate),\n        )\n        proc.start()\n        proc.join()\n        exitcode = proc.exitcode\n    except Exception as exc:\n        # multiprocessing unavailable -> try once in-process.\n        print(\n            f\"  Warning: could not isolate the enhance step ({exc}); \"\n            \"running it in-process.\",\n            file=sys.stderr,\n        )\n        try:\n            enhance_audio(raw_audio_path, enhanced_audio_path, sample_rate)\n            exitcode = 0\n        except Exception as exc2:\n            print(f\"  Enhance step failed: {exc2}\", file=sys.stderr)\n            exitcode = 1\n\n    return exitcode == 0 and os.path.isfile(enhanced_audio_path)\n\n\ndef extract_json(text):\n    \"\"\"Extract the last well-formed JSON object from a string by brace depth.\"\"\"\n    start = text.rfind(\"{\")\n    if start == -1:\n        return None\n    depth = 0\n    end = -1\n    for i in range(start, len(text)):\n        if text[i] == \"{\":\n            depth += 1\n        elif text[i] == \"}\":\n            depth -= 1\n            if depth == 0:\n                end = i + 1\n                break\n    if end == -1:\n        return None\n    return json.loads(text[start:end])\n\n\ndef measure_loudness(filepath, target_i, target_tp, target_lra):\n    \"\"\"Run loudnorm analysis pass and return measured loudness values.\"\"\"\n    filter_desc = (\n        f\"loudnorm=I={target_i}:TP={target_tp}:LRA={target_lra}\"\n        f\":print_format=json\"\n    )\n    cmd = [\n        \"ffmpeg\",\n        \"-i\", filepath,\n        \"-af\", filter_desc,\n        \"-f\", \"null\",\n        \"-\",\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n\n    if result.returncode != 0:\n        print(\"Error during loudness measurement pass.\", file=sys.stderr)\n        # Print last portion of stderr for debugging\n        lines = result.stderr.strip().splitlines()\n        for line in lines[-10:]:\n            print(line, file=sys.stderr)\n        sys.exit(1)\n\n    data = extract_json(result.stderr)\n    if data is None:\n        print(\n            \"Error: Could not parse loudness measurement output from FFmpeg.\",\n            file=sys.stderr,\n        )\n        sys.exit(1)\n\n    return {\n        \"input_i\": float(data[\"input_i\"]),\n        \"input_tp\": float(data[\"input_tp\"]),\n        \"input_lra\": float(data[\"input_lra\"]),\n        \"input_thresh\": float(data[\"input_thresh\"]),\n    }\n\n\ndef estimate_noise_floor(filepath, duration=3):\n    \"\"\"Estimate noise floor level using astats filter on a short sample.\n\n    Analyzes the first `duration` seconds of audio to estimate the noise\n    floor. The noise floor is approximated as the 10th percentile of RMS\n    levels across all frames (the quietest non-silent frames).\n\n    Returns the estimated noise floor in dB RMS, or None if estimation fails.\n    \"\"\"\n    cmd = [\n        \"ffmpeg\",\n        \"-i\", filepath,\n        \"-t\", str(duration),\n        \"-af\", \"astats=metadata=1:reset=1\",\n        \"-f\", \"null\",\n        \"-\",\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n\n    if result.returncode != 0:\n        return None\n\n    rms_levels = []\n    for line in result.stderr.splitlines():\n        if \"RMS level dB\" in line:\n            try:\n                rms = float(line.split(\"RMS level dB:\")[1].strip())\n                # Filter out near-silence frames (likely actual silence, not noise)\n                if rms > -80:\n                    rms_levels.append(rms)\n            except (ValueError, IndexError):\n                pass\n\n    if len(rms_levels) < 10:\n        return None\n\n    # The noise floor is estimated as the 10th percentile of RMS levels\n    # (the quietest 10% of non-silent frames are likely noise-dominated)\n    rms_levels.sort()\n    percentile_10 = rms_levels[int(len(rms_levels) * 0.1)]\n\n    return percentile_10\n\n\ndef normalize(input_path, output_path, target_i, target_tp, target_lra, nr_amount):\n    \"\"\"Run the enhanced + normalized output pipeline.\n\n    Steps:\n        1. Extract audio from `input_path` to a temp WAV at the input sample rate.\n        2. Enhance voice (noisereduce + Pedalboard) — isolated in a child\n           process; if the enhance backend is unusable, fall back to the plain\n           FFmpeg pipeline so an output is still produced.\n        3. Pass 1: measure integrated loudness of the (enhanced) audio.\n        4. Pass 2: loudness-normalize (loudnorm) + true-peak protection, encode\n           to AAC 192k, and mux with the (copied) video stream.\n\n    All temporary files are removed afterwards, including on error.\n\n    Returns (input_i, offset, enhance_used).\n    \"\"\"\n    sample_rate = get_audio_sample_rate(input_path) or 44100\n    video_present = has_video(input_path)\n\n    temp_dir = tempfile.mkdtemp(prefix=\"normalize_\")\n    raw_wav = os.path.join(temp_dir, \"input_raw.wav\")\n    enhanced_wav = os.path.join(temp_dir, \"input_enhanced.wav\")\n\n    try:\n        # --- Step 1: extract audio to WAV at the input sample rate ---\n        print(f\"Step 1/3: Extracting audio ({sample_rate} Hz)...\")\n        extract_audio_wav(input_path, raw_wav, sample_rate)\n\n        # --- Step 2: enhance voice (isolated, degrades gracefully) ---\n        print(\"Step 2/3: Enhancing voice...\")\n        enhance_used = enhance_audio_isolated(raw_wav, enhanced_wav, sample_rate)\n\n        if enhance_used:\n            audio_for_norm = enhanced_wav\n        else:\n            print(\n                \"  Warning: voice enhancement backend ('pedalboard'/'noisereduce') \"\n                \"is not usable on this system;\",\n                file=sys.stderr,\n            )\n            print(\n                \"  falling back to the plain FFmpeg pipeline (noise reduction + \"\n                \"loudness normalization).\",\n                file=sys.stderr,\n            )\n            audio_for_norm = raw_wav\n\n        # --- Step 3, Pass 1: measure loudness of the audio to normalize ---\n        print(\"Step 3/3: Measuring loudness...\")\n        measured = measure_loudness(audio_for_norm, target_i, target_tp, target_lra)\n\n        input_i = measured[\"input_i\"]\n        input_tp = measured[\"input_tp\"]\n        input_lra = measured[\"input_lra\"]\n        input_thresh = measured[\"input_thresh\"]\n\n        # Estimate noise floor for better logging (works on both paths).\n        noise_floor = estimate_noise_floor(audio_for_norm)\n        if noise_floor is not None:\n            print(f\"  Estimated noise floor after enhancement: {noise_floor:.1f} dB RMS\")\n\n        # CRITICAL: offset MUST be 0 when using two-pass loudnorm with\n        # measured values (measured_I, measured_TP, etc.). The measured\n        # values already tell loudnorm exactly how much linear gain to\n        # apply to hit the target (-30.2 -> -14 = +16.2 dB).\n        # The 'offset' parameter is ADDITIONAL gain on TOP of that\n        # normalization, which would DOUBLE the required gain and\n        # drastically amplify the noise floor on quiet segments.\n        # Fix: offset=0 to avoid double-gain / noise amplification.\n        offset = 0.0\n        total_gain_lu = target_i - input_i\n\n        # Build the filter chain. When enhance ran, it already performed noise\n        # reduction (noisereduce + NoiseGate + HighPass), so afftdn is skipped\n        # to avoid double noise reduction. afftdn is only used on the fallback path.\n        filters = []\n        if not enhance_used and nr_amount > 0:\n            # On the fallback path: more aggressive afftdn + adaptive gate\n            # to suppress residual noise floor BEFORE loudnorm.\n            nr_val = max(nr_amount, 8)\n            # afftdn = adaptive frequency-domain noise reduction\n            filters.append(f\"afftdn=nr={nr_val}:tn=1\")\n            # agate = adaptive gate to keep noise floor down on quiet segments\n            # threshold at -36 dB, ratio 3:1, fast attack (1ms), slower release (150ms)\n            filters.append(\"agate=threshold=-36dB:ratio=3:attack=1:release=150\")\n\n        filters.append(\n            f\"loudnorm=I={target_i}:TP={target_tp}:LRA={target_lra}\"\n            f\":measured_I={input_i}:measured_TP={input_tp}\"\n            f\":measured_LRA={input_lra}:measured_thresh={input_thresh}\"\n            f\":offset={offset}:linear=true\"\n        )\n        # +2 dB gain (linear = 10^(2/20) ≈ 1.26) before true-peak limiter\n        filters.append(\"volume=1.26\")\n        # True-peak limiter at -1 dBTP (limit=0.995 ≈ -0.04 dBFS, combined with loudnorm TP=-1.0 gives ~-1 dBTP)\n        filters.append(\"alimiter=limit=0.995:attack=5:release=50:level=true\")\n\n        filter_desc = \",\".join(filters)\n\n        # Pass 2: apply filters to the (enhanced) audio and mux with copied video.\n        cmd = [\"ffmpeg\", \"-y\", \"-i\", input_path, \"-i\", audio_for_norm]\n\n        if video_present:\n            # Copy the video stream without re-encoding; take audio from the\n            # processed WAV (input 1).\n            cmd.extend([\"-map\", \"0:v:0\", \"-map\", \"1:a:0\", \"-c:v\", \"copy\"])\n        else:\n            cmd.extend([\"-map\", \"1:a:0\"])\n\n        # loudnorm internally works at 192 kHz, which would otherwise bump the\n        # encoded rate; pin the output rate to the input sample rate.\n        cmd.extend([\"-af\", filter_desc, \"-ar\", str(sample_rate)])\n        cmd.extend([\"-c:a\", \"aac\", \"-b:a\", \"192k\"])\n        cmd.append(output_path)\n\n        result = subprocess.run(cmd, capture_output=True, text=True)\n\n        if result.returncode != 0:\n            print(\"Error during normalization pass.\", file=sys.stderr)\n            lines = result.stderr.strip().splitlines()\n            for line in lines[-10:]:\n                print(line, file=sys.stderr)\n            sys.exit(1)\n\n        return input_i, total_gain_lu, enhance_used\n    finally:\n        # Always clean up temporary WAV files, even on error.\n        shutil.rmtree(temp_dir, ignore_errors=True)\n\n\ndef main():\n    parser = argparse.ArgumentParser(\n        description=(\n            \"Enhance and normalize audio of video/audio files: voice enhancement \"\n            \"(noisereduce + Pedalboard) followed by two-pass EBU R128 loudness \"\n            \"normalization to a target integrated loudness level (LUFS).\"\n        )\n    )\n    parser.add_argument(\"input\", help=\"Input video or audio file\")\n    parser.add_argument(\n        \"-o\", \"--output\",\n        help=\"Output file path (default: <input>_normalized<ext>)\",\n    )\n    parser.add_argument(\n        \"--target\",\n        type=float,\n        default=DEFAULT_TARGET,\n        help=f\"Target integrated loudness in LUFS (default: {DEFAULT_TARGET})\",\n    )\n    parser.add_argument(\n        \"--nr\",\n        type=float,\n        default=DEFAULT_NR,\n        help=(\n            f\"Noise reduction amount in dB using afftdn (0=off, default: {DEFAULT_NR}). \"\n            \"The enhance stage already performs noise reduction, so afftdn is \"\n            \"skipped on the normal path; this value is used only when the \"\n            \"enhance backend is unavailable.\"\n        ),\n    )\n\n    args = parser.parse_args()\n\n    check_ffmpeg()\n\n    input_path = args.input\n\n    if not os.path.isfile(input_path):\n        print(f\"Error: Input file not found: {input_path}\", file=sys.stderr)\n        sys.exit(1)\n\n    if not has_audio(input_path):\n        print(f\"Error: No audio stream found in: {input_path}\", file=sys.stderr)\n        sys.exit(1)\n\n    # Enhance voice is part of the defa...[truncated]"}, "error": null}}
{"timestamp": "2026-10-04T05:37:06.728464+00:00", "task_id": "e57b9cedc8f240a38163011452f781d7", "event": "tool_completed", "data": {"tool": "read_file", "tool_call_id": "call_00_og1SU940DSxGK1FAgp961232", "success": true, "error": null, "target": "includes/video_pipeline/audio_normalize.py", "metadata": {}}}
{"timestamp": "2026-10-04T05:37:06.728464+00:00", "task_id": "e57b9cedc8f240a38163011452f781d7", "event": "agent_observation", "data": {"action_id": "call_00_og1SU940DSxGK1FAgp961232", "success": true, "error": null, "content": {"path": "includes/video_pipeline/audio_normalize.py", "total_lines": 594, "content": "#!/usr/bin/env python3\n\"\"\"normalize.py - Enhance and normalize audio of video/audio files using FFmpeg.\n\nDefault pipeline:\n    Input video/audio\n    → Extract audio to a temporary WAV at the *input* sample rate (FFmpeg)\n    → Enhance voice (noisereduce + Pedalboard)\n    → Two-pass EBU R128 loudness normalization + true-peak protection (FFmpeg)\n    → Output video/audio (video stream copied, audio re-encoded to AAC 192k)\n\nThe \"enhance voice\" stage uses the `pedalboard` and `noisereduce` Python\npackages and runs automatically as part of the standard pipeline. Because the\nenhance stage already performs noise reduction (noisereduce + NoiseGate),\nFFmpeg's `afftdn` is NOT applied on top of it (avoids double noise reduction /\nloss of detail).\n\nThe video stream is always copied without re-encoding, preserving resolution,\nframe rate, duration and A/V sync. The audio sample rate follows the input.\n\nUsage:\n    python normalize.py a.mp4\n    python normalize.py a.mp4 -o hasil.mp4\n    python normalize.py a.mp4 --target -14\n\"\"\"\n\nimport argparse\nimport json\nimport multiprocessing\nimport shutil\nimport subprocess\nimport sys\nimport os\nimport tempfile\n\n\nDEFAULT_TARGET = -14.0\nDEFAULT_TRUE_PEAK = -1.0\nDEFAULT_LRA = 11.0\n# afftdn noise reduction (dB) used only when the enhance backend is\n# unavailable. On the normal (enhance) path afftdn is skipped because the\n# enhance stage already reduces noise.\nDEFAULT_NR = 3\n\n\n# ---------------------------------------------------------------------------\n# Optional \"enhance voice\" dependencies (pedalboard + noisereduce).\n# Imported defensively so the CLI can still print --help / a clear error\n# instead of dumping a raw traceback when the packages are missing.\n# ---------------------------------------------------------------------------\ntry:\n    from pedalboard import (\n        NoiseGate,\n        Compressor,\n        LowShelfFilter,\n        HighShelfFilter,\n        HighpassFilter,\n        Pedalboard,\n    )\n    from pedalboard.io import AudioFile\n    import noisereduce as nr\n\n    _ENHANCE_IMPORT_ERROR = None\nexcept Exception as _exc:  # ImportError, or a numpy ABI mismatch, etc.\n    _ENHANCE_IMPORT_ERROR = _exc\n\n\ndef check_enhance_deps():\n    \"\"\"Fail with a clear, actionable message if enhance deps are unavailable.\"\"\"\n    if _ENHANCE_IMPORT_ERROR is not None:\n        print(\n            \"Error: the 'enhance voice' step requires the Python packages \"\n            \"'pedalboard' and 'noisereduce', but they could not be imported.\",\n            file=sys.stderr,\n        )\n        print(f\"       Detail: {_ENHANCE_IMPORT_ERROR}\", file=sys.stderr)\n        print(\"       Install them with:\", file=sys.stderr)\n        print(\n            f\"         {sys.executable} -m pip install pedalboard noisereduce\",\n            file=sys.stderr,\n        )\n        sys.exit(1)\n\n\ndef check_ffmpeg():\n    \"\"\"Ensure ffmpeg and ffprobe are available.\"\"\"\n    for cmd in (\"ffmpeg\", \"ffprobe\"):\n        if shutil.which(cmd) is None:\n            print(\n                f\"Error: '{cmd}' is not installed or not in PATH.\",\n                file=sys.stderr,\n            )\n            print(\n                \"Please install FFmpeg: https://ffmpeg.org/download.html\",\n                file=sys.stderr,\n            )\n            sys.exit(1)\n\n\ndef has_stream(filepath, stream_type):\n    \"\"\"Check if file has at least one stream of the given type ('a' or 'v').\"\"\"\n    cmd = [\n        \"ffprobe\",\n        \"-v\", \"error\",\n        \"-select_streams\", stream_type,\n        \"-show_entries\", \"stream=codec_type\",\n        \"-of\", \"csv=p=0\",\n        filepath,\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    return result.returncode == 0 and result.stdout.strip() != \"\"\n\n\ndef has_audio(filepath):\n    return has_stream(filepath, \"a\")\n\n\ndef has_video(filepath):\n    return has_stream(filepath, \"v\")\n\n\ndef get_audio_sample_rate(filepath):\n    \"\"\"Return the sample rate (int Hz) of the first audio stream, or None.\"\"\"\n    cmd = [\n        \"ffprobe\",\n        \"-v\", \"error\",\n        \"-select_streams\", \"a:0\",\n        \"-show_entries\", \"stream=sample_rate\",\n        \"-of\", \"default=noprint_wrappers=1:nokey=1\",\n        filepath,\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    if result.returncode != 0:\n        return None\n    out = result.stdout.strip()\n    if not out:\n        return None\n    try:\n        return int(float(out))\n    except ValueError:\n        return None\n\n\ndef extract_audio_wav(input_path, wav_path, sample_rate):\n    \"\"\"Extract the audio stream to a WAV file at the given sample rate.\"\"\"\n    cmd = [\n        \"ffmpeg\",\n        \"-y\",\n        \"-i\", input_path,\n        \"-vn\",\n        \"-acodec\", \"pcm_s16le\",\n        \"-ar\", str(int(sample_rate)),\n        wav_path,\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    if result.returncode != 0:\n        print(\n            \"Error: failed to extract audio to a temporary WAV file.\",\n            file=sys.stderr,\n        )\n        for line in result.stderr.strip().splitlines()[-10:]:\n            print(line, file=sys.stderr)\n        sys.exit(1)\n\n\ndef enhance_audio(raw_audio_path, enhanced_audio_path, sample_rate):\n    \"\"\"Enhance human voice in an audio file (noisereduce + Pedalboard).\n\n    Chain:\n        noisereduce.reduce_noise(stationary=True, prop_decrease=0.6)\n        -> Pedalboard [\n               HighpassFilter(80 Hz),                    # kill rumble below 80 Hz\n               NoiseGate(-38 dB, ratio 2.5, release 400 ms),\n               Compressor(-20 dB, ratio 2.5),\n               LowShelfFilter(300 Hz, +4 dB, q 1),       # gentle vocal lift\n               HighShelfFilter(1200 Hz, +1.5 dB, q 0.7),\n           ]\n\n    NOTE: The old fixed Gain(+13 dB) makeup is REMOVED. Loudness is handled by\n    the two-pass EBU R128 loudnorm stage, which is applied AFTER this chain.\n    A fixed +13 dB gain on top of loudnorm was amplifying the noise floor on\n    silent segments.\n\n    NoiseGate threshold was dropped to -38 dB (relative to a noise floor that\n    is itself much lower after noisereduce + high-pass) so that speech above\n    the (reduced) noise floor stays open while residual hiss on quiet segments\n    is suppressed. Gate runs BEFORE any make-up/level gain.\n\n    The input is read at `sample_rate` (which should be the file's own sample\n    rate, so no unnecessary resampling occurs) and the result is written back\n    at the same rate. Output is audio-only (no video).\n    \"\"\"\n    # === Read audio (keep the requested sample rate) ===\n    with AudioFile(raw_audio_path).resampled_to(sample_rate) as f:\n        audio = f.read(f.frames)\n        sr = f.samplerate\n\n    # === Noise reduction (stationary) ===\n    # noisereduce expects (channels, samples) for stereo; pedalboard's\n    # AudioFile.read() already returns (channels, samples), so this is safe.\n    reduced_noise = nr.reduce_noise(\n        y=audio, sr=sr, stationary=True, prop_decrease=0.6\n    )\n\n    # Chain WITHOUT fixed makeup gain. Loudness is set by loudnorm afterwards.\n    board = Pedalboard([\n        HighpassFilter(cutoff_frequency_hz=80),\n        NoiseGate(threshold_db=-38, ratio=2.5, release_ms=400),\n        Compressor(threshold_db=-20, ratio=2.5),\n        LowShelfFilter(cutoff_frequency_hz=300, gain_db=4, q=1),\n        HighShelfFilter(cutoff_frequency_hz=1200, gain_db=1.5, q=0.7),\n    ])\n\n    effected = board(reduced_noise, sr)\n\n    # === Write enhanced audio to file ===\n    with AudioFile(enhanced_audio_path, \"w\", sr, effected.shape[0]) as f:\n        f.write(effected)\n\n\ndef _enhance_child(raw_audio_path, enhanced_audio_path, sample_rate):\n    \"\"\"Child-process entry point that runs ``enhance_audio``.\n\n    Defined at module level so it can be pickled by the Windows 'spawn' start\n    method. A Python-level failure exits non-zero without dumping a raw\n    traceback; a native crash of pedalboard simply kills the child, which the\n    parent detects via the exit code.\n    \"\"\"\n    try:\n        enhance_audio(raw_audio_path, enhanced_audio_path, sample_rate)\n    except Exception as exc:  # defensive: keep the parent's output clean\n        sys.stderr.write(f\"enhance step failed: {exc}\\n\")\n        sys.stderr.flush()\n        os._exit(1)\n\n\ndef enhance_audio_isolated(raw_audio_path, enhanced_audio_path, sample_rate):\n    \"\"\"Run ``enhance_audio`` in a child process; return True on success.\n\n    The pedalboard/noisereduce call is native code that can crash the whole\n    interpreter on some systems. Running it in a child process lets the CLI\n    detect the failure (via the exit code) and degrade gracefully instead of\n    aborting with an access violation.\n    \"\"\"\n    try:\n        ctx = multiprocessing.get_context(\"spawn\")\n        proc = ctx.Process(\n            target=_enhance_child,\n            args=(raw_audio_path, enhanced_audio_path, sample_rate),\n        )\n        proc.start()\n        proc.join()\n        exitcode = proc.exitcode\n    except Exception as exc:\n        # multiprocessing unavailable -> try once in-process.\n        print(\n            f\"  Warning: could not isolate the enhance step ({exc}); \"\n            \"running it in-process.\",\n            file=sys.stderr,\n        )\n        try:\n            enhance_audio(raw_audio_path, enhanced_audio_path, sample_rate)\n            exitcode = 0\n        except Exception as exc2:\n            print(f\"  Enhance step failed: {exc2}\", file=sys.stderr)\n            exitcode = 1\n\n    return exitcode == 0 and os.path.isfile(enhanced_audio_path)\n\n\ndef extract_json(text):\n    \"\"\"Extract the last well-formed JSON object from a string by brace depth.\"\"\"\n    start = text.rfind(\"{\")\n    if start == -1:\n        return None\n    depth = 0\n    end = -1\n    for i in range(start, len(text)):\n        if text[i] == \"{\":\n            depth += 1\n        elif text[i] == \"}\":\n            depth -= 1\n            if depth == 0:\n                end = i + 1\n                break\n    if end == -1:\n        return None\n    return json.loads(text[start:end])\n\n\ndef measure_loudness(filepath, target_i, target_tp, target_lra):\n    \"\"\"Run loudnorm analysis pass and return measured loudness values.\"\"\"\n    filter_desc = (\n        f\"loudnorm=I={target_i}:TP={target_tp}:LRA={target_lra}\"\n        f\":print_format=json\"\n    )\n    cmd = [\n        \"ffmpeg\",\n        \"-i\", filepath,\n        \"-af\", filter_desc,\n        \"-f\", \"null\",\n        \"-\",\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n\n    if result.returncode != 0:\n        print(\"Error during loudness measurement pass.\", file=sys.stderr)\n        # Print last portion of stderr for debugging\n        lines = result.stderr.strip().splitlines()\n        for line in lines[-10:]:\n            print(line, file=sys.stderr)\n        sys.exit(1)\n\n    data = extract_json(result.stderr)\n    if data is None:\n        print(\n            \"Error: Could not parse loudness measurement output from FFmpeg.\",\n            file=sys.stderr,\n        )\n        sys.exit(1)\n\n    return {\n        \"input_i\": float(data[\"input_i\"]),\n        \"input_tp\": float(data[\"input_tp\"]),\n        \"input_lra\": float(data[\"input_lra\"]),\n        \"input_thresh\": float(data[\"input_thresh\"]),\n    }\n\n\ndef estimate_noise_floor(filepath, duration=3):\n    \"\"\"Estimate noise floor level using astats filter on a short sample.\n\n    Analyzes the first `duration` seconds of audio to estimate the noise\n    floor. The noise floor is approximated as the 10th percentile of RMS\n    levels across all frames (the quietest non-silent frames).\n\n    Returns the estimated noise floor in dB RMS, or None if estimation fails.\n    \"\"\"\n    cmd = [\n        \"ffmpeg\",\n        \"-i\", filepath,\n        \"-t\", str(duration),\n        \"-af\", \"astats=metadata=1:reset=1\",\n        \"-f\", \"null\",\n        \"-\",\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n\n    if result.returncode != 0:\n        return None\n\n    rms_levels = []\n    for line in result.stderr.splitlines():\n        if \"RMS level dB\" in line:\n            try:\n                rms = float(line.split(\"RMS level dB:\")[1].strip())\n                # Filter out near-silence frames (likely actual silence, not noise)\n                if rms > -80:\n                    rms_levels.append(rms)\n            except (ValueError, IndexError):\n                pass\n\n    if len(rms_levels) < 10:\n        return None\n\n    # The noise floor is estimated as the 10th percentile of RMS levels\n    # (the quietest 10% of non-silent frames are likely noise-dominated)\n    rms_levels.sort()\n    percentile_10 = rms_levels[int(len(rms_levels) * 0.1)]\n\n    return percentile_10\n\n\ndef normalize(input_path, output_path, target_i, target_tp, target_lra, nr_amount):\n    \"\"\"Run the enhanced + normalized output pipeline.\n\n    Steps:\n        1. Extract audio from `input_path` to a temp WAV at the input sample rate.\n        2. Enhance voice (noisereduce + Pedalboard) — isolated in a child\n           process; if the enhance backend is unusable, fall back to the plain\n           FFmpeg pipeline so an output is still produced.\n        3. Pass 1: measure integrated loudness of the (enhanced) audio.\n        4. Pass 2: loudness-normalize (loudnorm) + true-peak protection, encode\n           to AAC 192k, and mux with the (copied) video stream.\n\n    All temporary files are removed afterwards, including on error.\n\n    Returns (input_i, offset, enhance_used).\n    \"\"\"\n    sample_rate = get_audio_sample_rate(input_path) or 44100\n    video_present = has_video(input_path)\n\n    temp_dir = tempfile.mkdtemp(prefix=\"normalize_\")\n    raw_wav = os.path.join(temp_dir, \"input_raw.wav\")\n    enhanced_wav = os.path.join(temp_dir, \"input_enhanced.wav\")\n\n    try:\n        # --- Step 1: extract audio to WAV at the input sample rate ---\n        print(f\"Step 1/3: Extracting audio ({sample_rate} Hz)...\")\n        extract_audio_wav(input_path, raw_wav, sample_rate)\n\n        # --- Step 2: enhance voice (isolated, degrades gracefully) ---\n        print(\"Step 2/3: Enhancing voice...\")\n        enhance_used = enhance_audio_isolated(raw_wav, enhanced_wav, sample_rate)\n\n        if enhance_used:\n            audio_for_norm = enhanced_wav\n        else:\n            print(\n                \"  Warning: voice enhancement backend ('pedalboard'/'noisereduce') \"\n                \"is not usable on this system;\",\n                file=sys.stderr,\n            )\n            print(\n                \"  falling back to the plain FFmpeg pipeline (noise reduction + \"\n                \"loudness normalization).\",\n                file=sys.stderr,\n            )\n            audio_for_norm = raw_wav\n\n        # --- Step 3, Pass 1: measure loudness of the audio to normalize ---\n        print(\"Step 3/3: Measuring loudness...\")\n        measured = measure_loudness(audio_for_norm, target_i, target_tp, target_lra)\n\n        input_i = measured[\"input_i\"]\n        input_tp = measured[\"input_tp\"]\n        input_lra = measured[\"input_lra\"]\n        input_thresh = measured[\"input_thresh\"]\n\n        # Estimate noise floor for better logging (works on both paths).\n        noise_floor = estimate_noise_floor(audio_for_norm)\n        if noise_floor is not None:\n            print(f\"  Estimated noise floor after enhancement: {noise_floor:.1f} dB RMS\")\n\n        # CRITICAL: offset MUST be 0 when using two-pass loudnorm with\n        # measured values (measured_I, measured_TP, etc.). The measured\n        # values already tell loudnorm exactly how much linear gain to\n        # apply to hit the target (-30.2 -> -14 = +16.2 dB).\n        # The 'offset' parameter is ADDITIONAL gain on TOP of that\n        # normalization, which would DOUBLE the required gain and\n        # drastically amplify the noise floor on quiet segments.\n        # Fix: offset=0 to avoid double-gain / noise amplification.\n        offset = 0.0\n        total_gain_lu = target_i - input_i\n\n        # Build the filter chain. When enhance ran, it already performed noise\n        # reduction (noisereduce + NoiseGate + HighPass), so afftdn is skipped\n        # to avoid double noise reduction. afftdn is only used on the fallback path.\n        filters = []\n        if not enhance_used and nr_amount > 0:\n            # On the fallback path: more aggressive afftdn + adaptive gate\n            # to suppress residual noise floor BEFORE loudnorm.\n            nr_val = max(nr_amount, 8)\n            # afftdn = adaptive frequency-domain noise reduction\n            filters.append(f\"afftdn=nr={nr_val}:tn=1\")\n            # agate = adaptive gate to keep noise floor down on quiet segments\n            # threshold at -36 dB, ratio 3:1, fast attack (1ms), slower release (150ms)\n            filters.append(\"agate=threshold=-36dB:ratio=3:attack=1:release=150\")\n\n        filters.append(\n            f\"loudnorm=I={target_i}:TP={target_tp}:LRA={target_lra}\"\n            f\":measured_I={input_i}:measured_TP={input_tp}\"\n            f\":measured_LRA={input_lra}:measured_thresh={input_thresh}\"\n            f\":offset={offset}:linear=true\"\n        )\n        # +2 dB gain (linear = 10^(2/20) ≈ 1.26) before true-peak limiter\n        filters.append(\"volume=1.26\")\n        # True-peak limiter at -1 dBTP (limit=0.995 ≈ -0.04 dBFS, combined with loudnorm TP=-1.0 gives ~-1 dBTP)\n        filters.append(\"alimiter=limit=0.995:attack=5:release=50:level=true\")\n\n        filter_desc = \",\".join(filters)\n\n        # Pass 2: apply filters to the (enhanced) audio and mux with copied video.\n        cmd = [\"ffmpeg\", \"-y\", \"-i\", input_path, \"-i\", audio_for_norm]\n\n        if video_present:\n            # Copy the video stream without re-encoding; take audio from the\n            # processed WAV (input 1).\n            cmd.extend([\"-map\", \"0:v:0\", \"-map\", \"1:a:0\", \"-c:v\", \"copy\"])\n        else:\n            cmd.extend([\"-map\", \"1:a:0\"])\n\n        # loudnorm internally works at 192 kHz, which would otherwise bump the\n        # encoded rate; pin the output rate to the input sample rate.\n        cmd.extend([\"-af\", filter_desc, \"-ar\", str(sample_rate)])\n        cmd.extend([\"-c:a\", \"aac\", \"-b:a\", \"192k\"])\n        cmd.append(output_path)\n\n        result = subprocess.run(cmd, capture_output=True, text=True)\n\n        if result.returncode != 0:\n            print(\"Error during normalization pass.\", file=sys.stderr)\n            lines = result.stderr.strip().splitlines()\n            for line in lines[-10:]:\n                print(line, file=sys.stderr)\n            sys.exit(1)\n\n        return input_i, total_gain_lu, enhance_used\n    finally:\n        # Always clean up temporary WAV files, even on error.\n        shutil.rmtree(temp_dir, ignore_errors=True)\n\n\ndef main():\n    parser = argparse.ArgumentParser(\n        description=(\n            \"Enhance and normalize audio of video/audio files: voice enhancement \"\n            \"(noisereduce + Pedalboard) followed by two-pass EBU R128 loudness \"\n            \"normalization to a target integrated loudness level (LUFS).\"\n        )\n    )\n    parser.add_argument(\"input\", help=\"Input video or audio file\")\n    parser.add_argument(\n        \"-o\", \"--output\",\n        help=\"Output file path (default: <input>_normalized<ext>)\",\n    )\n    parser.add_argument(\n        \"--target\",\n        type=float,\n        default=DEFAULT_TARGET,\n        help=f\"Target integrated loudness in LUFS (default: {DEFAULT_TARGET})\",\n    )\n    parser.add_argument(\n        \"--nr\",\n        type=float,\n        default=DEFAULT_NR,\n        help=(\n            f\"Noise reduction amount in dB using afftdn (0=off, default: {DEFAULT_NR}). \"\n            \"The enhance stage already performs noise reduction, so afftdn is \"\n            \"skipped on the normal path; this value is used only when the \"\n            \"enhance backend is unavailable.\"\n        ),\n    )\n\n    args = parser.parse_args()\n\n    check_ffmpeg()\n\n    input_path = args.input\n\n    if not os.path.isfile(input_path):\n        print(f\"Error: Input file not found: {input_path}\", file=sys.stderr)\n        sys.exit(1)\n\n    if not has_audio(input_path):\n        print(f\"Error: No audio stream found in: {input_path}\", file=sys.stderr)\n        sys.exit(1)\n\n    # Enhance voice is part of the defa...[truncated]"}, "metadata": {"tool": "read_file"}}}
{"timestamp": "2026-10-04T05:37:06.729464+00:00", "task_id": "e57b9cedc8f240a38163011452f781d7", "event": "observation_received", "data": {"tool": "read_file", "tool_call_id": "call_00_og1SU940DSxGK1FAgp961232", "success": true, "content": {"path": "includes/video_pipeline/audio_normalize.py", "total_lines": 594, "content": "#!/usr/bin/env python3\n\"\"\"normalize.py - Enhance and normalize audio of video/audio files using FFmpeg.\n\nDefault pipeline:\n    Input video/audio\n    → Extract audio to a temporary WAV at the *input* sample rate (FFmpeg)\n    → Enhance voice (noisereduce + Pedalboard)\n    → Two-pass EBU R128 loudness normalization + true-peak protection (FFmpeg)\n    → Output video/audio (video stream copied, audio re-encoded to AAC 192k)\n\nThe \"enhance voice\" stage uses the `pedalboard` and `noisereduce` Python\npackages and runs automatically as part of the standard pipeline. Because the\nenhance stage already performs noise reduction (noisereduce + NoiseGate),\nFFmpeg's `afftdn` is NOT applied on top of it (avoids double noise reduction /\nloss of detail).\n\nThe video stream is always copied without re-encoding, preserving resolution,\nframe rate, duration and A/V sync. The audio sample rate follows the input.\n\nUsage:\n    python normalize.py a.mp4\n    python normalize.py a.mp4 -o hasil.mp4\n    python normalize.py a.mp4 --target -14\n\"\"\"\n\nimport argparse\nimport json\nimport multiprocessing\nimport shutil\nimport subprocess\nimport sys\nimport os\nimport tempfile\n\n\nDEFAULT_TARGET = -14.0\nDEFAULT_TRUE_PEAK = -1.0\nDEFAULT_LRA = 11.0\n# afftdn noise reduction (dB) used only when the enhance backend is\n# unavailable. On the normal (enhance) path afftdn is skipped because the\n# enhance stage already reduces noise.\nDEFAULT_NR = 3\n\n\n# ---------------------------------------------------------------------------\n# Optional \"enhance voice\" dependencies (pedalboard + noisereduce).\n# Imported defensively so the CLI can still print --help / a clear error\n# instead of dumping a raw traceback when the packages are missing.\n# ---------------------------------------------------------------------------\ntry:\n    from pedalboard import (\n        NoiseGate,\n        Compressor,\n        LowShelfFilter,\n        HighShelfFilter,\n        HighpassFilter,\n        Pedalboard,\n    )\n    from pedalboard.io import AudioFile\n    import noisereduce as nr\n\n    _ENHANCE_IMPORT_ERROR = None\nexcept Exception as _exc:  # ImportError, or a numpy ABI mismatch, etc.\n    _ENHANCE_IMPORT_ERROR = _exc\n\n\ndef check_enhance_deps():\n    \"\"\"Fail with a clear, actionable message if enhance deps are unavailable.\"\"\"\n    if _ENHANCE_IMPORT_ERROR is not None:\n        print(\n            \"Error: the 'enhance voice' step requires the Python packages \"\n            \"'pedalboard' and 'noisereduce', but they could not be imported.\",\n            file=sys.stderr,\n        )\n        print(f\"       Detail: {_ENHANCE_IMPORT_ERROR}\", file=sys.stderr)\n        print(\"       Install them with:\", file=sys.stderr)\n        print(\n            f\"         {sys.executable} -m pip install pedalboard noisereduce\",\n            file=sys.stderr,\n        )\n        sys.exit(1)\n\n\ndef check_ffmpeg():\n    \"\"\"Ensure ffmpeg and ffprobe are available.\"\"\"\n    for cmd in (\"ffmpeg\", \"ffprobe\"):\n        if shutil.which(cmd) is None:\n            print(\n                f\"Error: '{cmd}' is not installed or not in PATH.\",\n                file=sys.stderr,\n            )\n            print(\n                \"Please install FFmpeg: https://ffmpeg.org/download.html\",\n                file=sys.stderr,\n            )\n            sys.exit(1)\n\n\ndef has_stream(filepath, stream_type):\n    \"\"\"Check if file has at least one stream of the given type ('a' or 'v').\"\"\"\n    cmd = [\n        \"ffprobe\",\n        \"-v\", \"error\",\n        \"-select_streams\", stream_type,\n        \"-show_entries\", \"stream=codec_type\",\n        \"-of\", \"csv=p=0\",\n        filepath,\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    return result.returncode == 0 and result.stdout.strip() != \"\"\n\n\ndef has_audio(filepath):\n    return has_stream(filepath, \"a\")\n\n\ndef has_video(filepath):\n    return has_stream(filepath, \"v\")\n\n\ndef get_audio_sample_rate(filepath):\n    \"\"\"Return the sample rate (int Hz) of the first audio stream, or None.\"\"\"\n    cmd = [\n        \"ffprobe\",\n        \"-v\", \"error\",\n        \"-select_streams\", \"a:0\",\n        \"-show_entries\", \"stream=sample_rate\",\n        \"-of\", \"default=noprint_wrappers=1:nokey=1\",\n        filepath,\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    if result.returncode != 0:\n        return None\n    out = result.stdout.strip()\n    if not out:\n        return None\n    try:\n        return int(float(out))\n    except ValueError:\n        return None\n\n\ndef extract_audio_wav(input_path, wav_path, sample_rate):\n    \"\"\"Extract the audio stream to a WAV file at the given sample rate.\"\"\"\n    cmd = [\n        \"ffmpeg\",\n        \"-y\",\n        \"-i\", input_path,\n        \"-vn\",\n        \"-acodec\", \"pcm_s16le\",\n        \"-ar\", str(int(sample_rate)),\n        wav_path,\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    if result.returncode != 0:\n        print(\n            \"Error: failed to extract audio to a temporary WAV file.\",\n            file=sys.stderr,\n        )\n        for line in result.stderr.strip().splitlines()[-10:]:\n            print(line, file=sys.stderr)\n        sys.exit(1)\n\n\ndef enhance_audio(raw_audio_path, enhanced_audio_path, sample_rate):\n    \"\"\"Enhance human voice in an audio file (noisereduce + Pedalboard).\n\n    Chain:\n        noisereduce.reduce_noise(stationary=True, prop_decrease=0.6)\n        -> Pedalboard [\n               HighpassFilter(80 Hz),                    # kill rumble below 80 Hz\n               NoiseGate(-38 dB, ratio 2.5, release 400 ms),\n               Compressor(-20 dB, ratio 2.5),\n               LowShelfFilter(300 Hz, +4 dB, q 1),       # gentle vocal lift\n               HighShelfFilter(1200 Hz, +1.5 dB, q 0.7),\n           ]\n\n    NOTE: The old fixed Gain(+13 dB) makeup is REMOVED. Loudness is handled by\n    the two-pass EBU R128 loudnorm stage, which is applied AFTER this chain.\n    A fixed +13 dB gain on top of loudnorm was amplifying the noise floor on\n    silent segments.\n\n    NoiseGate threshold was dropped to -38 dB (relative to a noise floor that\n    is itself much lower after noisereduce + high-pass) so that speech above\n    the (reduced) noise floor stays open while residual hiss on quiet segments\n    is suppressed. Gate runs BEFORE any make-up/level gain.\n\n    The input is read at `sample_rate` (which should be the file's own sample\n    rate, so no unnecessary resampling occurs) and the result is written back\n    at the same rate. Output is audio-only (no video).\n    \"\"\"\n    # === Read audio (keep the requested sample rate) ===\n    with AudioFile(raw_audio_path).resampled_to(sample_rate) as f:\n        audio = f.read(f.frames)\n        sr = f.samplerate\n\n    # === Noise reduction (stationary) ===\n    # noisereduce expects (channels, samples) for stereo; pedalboard's\n    # AudioFile.read() already returns (channels, samples), so this is safe.\n    reduced_noise = nr.reduce_noise(\n        y=audio, sr=sr, stationary=True, prop_decrease=0.6\n    )\n\n    # Chain WITHOUT fixed makeup gain. Loudness is set by loudnorm afterwards.\n    board = Pedalboard([\n        HighpassFilter(cutoff_frequency_hz=80),\n        NoiseGate(threshold_db=-38, ratio=2.5, release_ms=400),\n        Compressor(threshold_db=-20, ratio=2.5),\n        LowShelfFilter(cutoff_frequency_hz=300, gain_db=4, q=1),\n        HighShelfFilter(cutoff_frequency_hz=1200, gain_db=1.5, q=0.7),\n    ])\n\n    effected = board(reduced_noise, sr)\n\n    # === Write enhanced audio to file ===\n    with AudioFile(enhanced_audio_path, \"w\", sr, effected.shape[0]) as f:\n        f.write(effected)\n\n\ndef _enhance_child(raw_audio_path, enhanced_audio_path, sample_rate):\n    \"\"\"Child-process entry point that runs ``enhance_audio``.\n\n    Defined at module level so it can be pickled by the Windows 'spawn' start\n    method. A Python-level failure exits non-zero without dumping a raw\n    traceback; a native crash of pedalboard simply kills the child, which the\n    parent detects via the exit code.\n    \"\"\"\n    try:\n        enhance_audio(raw_audio_path, enhanced_audio_path, sample_rate)\n    except Exception as exc:  # defensive: keep the parent's output clean\n        sys.stderr.write(f\"enhance step failed: {exc}\\n\")\n        sys.stderr.flush()\n        os._exit(1)\n\n\ndef enhance_audio_isolated(raw_audio_path, enhanced_audio_path, sample_rate):\n    \"\"\"Run ``enhance_audio`` in a child process; return True on success.\n\n    The pedalboard/noisereduce call is native code that can crash the whole\n    interpreter on some systems. Running it in a child process lets the CLI\n    detect the failure (via the exit code) and degrade gracefully instead of\n    aborting with an access violation.\n    \"\"\"\n    try:\n        ctx = multiprocessing.get_context(\"spawn\")\n        proc = ctx.Process(\n            target=_enhance_child,\n            args=(raw_audio_path, enhanced_audio_path, sample_rate),\n        )\n        proc.start()\n        proc.join()\n        exitcode = proc.exitcode\n    except Exception as exc:\n        # multiprocessing unavailable -> try once in-process.\n        print(\n            f\"  Warning: could not isolate the enhance step ({exc}); \"\n            \"running it in-process.\",\n            file=sys.stderr,\n        )\n        try:\n            enhance_audio(raw_audio_path, enhanced_audio_path, sample_rate)\n            exitcode = 0\n        except Exception as exc2:\n            print(f\"  Enhance step failed: {exc2}\", file=sys.stderr)\n            exitcode = 1\n\n    return exitcode == 0 and os.path.isfile(enhanced_audio_path)\n\n\ndef extract_json(text):\n    \"\"\"Extract the last well-formed JSON object from a string by brace depth.\"\"\"\n    start = text.rfind(\"{\")\n    if start == -1:\n        return None\n    depth = 0\n    end = -1\n    for i in range(start, len(text)):\n        if text[i] == \"{\":\n            depth += 1\n        elif text[i] == \"}\":\n            depth -= 1\n            if depth == 0:\n                end = i + 1\n                break\n    if end == -1:\n        return None\n    return json.loads(text[start:end])\n\n\ndef measure_loudness(filepath, target_i, target_tp, target_lra):\n    \"\"\"Run loudnorm analysis pass and return measured loudness values.\"\"\"\n    filter_desc = (\n        f\"loudnorm=I={target_i}:TP={target_tp}:LRA={target_lra}\"\n        f\":print_format=json\"\n    )\n    cmd = [\n        \"ffmpeg\",\n        \"-i\", filepath,\n        \"-af\", filter_desc,\n        \"-f\", \"null\",\n        \"-\",\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n\n    if result.returncode != 0:\n        print(\"Error during loudness measurement pass.\", file=sys.stderr)\n        # Print last portion of stderr for debugging\n        lines = result.stderr.strip().splitlines()\n        for line in lines[-10:]:\n            print(line, file=sys.stderr)\n        sys.exit(1)\n\n    data = extract_json(result.stderr)\n    if data is None:\n        print(\n            \"Error: Could not parse loudness measurement output from FFmpeg.\",\n            file=sys.stderr,\n        )\n        sys.exit(1)\n\n    return {\n        \"input_i\": float(data[\"input_i\"]),\n        \"input_tp\": float(data[\"input_tp\"]),\n        \"input_lra\": float(data[\"input_lra\"]),\n        \"input_thresh\": float(data[\"input_thresh\"]),\n    }\n\n\ndef estimate_noise_floor(filepath, duration=3):\n    \"\"\"Estimate noise floor level using astats filter on a short sample.\n\n    Analyzes the first `duration` seconds of audio to estimate the noise\n    floor. The noise floor is approximated as the 10th percentile of RMS\n    levels across all frames (the quietest non-silent frames).\n\n    Returns the estimated noise floor in dB RMS, or None if estimation fails.\n    \"\"\"\n    cmd = [\n        \"ffmpeg\",\n        \"-i\", filepath,\n        \"-t\", str(duration),\n        \"-af\", \"astats=metadata=1:reset=1\",\n        \"-f\", \"null\",\n        \"-\",\n    ]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n\n    if result.returncode != 0:\n        return None\n\n    rms_levels = []\n    for line in result.stderr.splitlines():\n        if \"RMS level dB\" in line:\n            try:\n                rms = float(line.split(\"RMS level dB:\")[1].strip())\n                # Filter out near-silence frames (likely actual silence, not noise)\n                if rms > -80:\n                    rms_levels.append(rms)\n            except (ValueError, IndexError):\n                pass\n\n    if len(rms_levels) < 10:\n        return None\n\n    # The noise floor is estimated as the 10th percentile of RMS levels\n    # (the quietest 10% of non-silent frames are likely noise-dominated)\n    rms_levels.sort()\n    percentile_10 = rms_levels[int(len(rms_levels) * 0.1)]\n\n    return percentile_10\n\n\ndef normalize(input_path, output_path, target_i, target_tp, target_lra, nr_amount):\n    \"\"\"Run the enhanced + normalized output pipeline.\n\n    Steps:\n        1. Extract audio from `input_path` to a temp WAV at the input sample rate.\n        2. Enhance voice (noisereduce + Pedalboard) — isolated in a child\n           process; if the enhance backend is unusable, fall back to the plain\n           FFmpeg pipeline so an output is still produced.\n        3. Pass 1: measure integrated loudness of the (enhanced) audio.\n        4. Pass 2: loudness-normalize (loudnorm) + true-peak protection, encode\n           to AAC 192k, and mux with the (copied) video stream.\n\n    All temporary files are removed afterwards, including on error.\n\n    Returns (input_i, offset, enhance_used).\n    \"\"\"\n    sample_rate = get_audio_sample_rate(input_path) or 44100\n    video_present = has_video(input_path)\n\n    temp_dir = tempfile.mkdtemp(prefix=\"normalize_\")\n    raw_wav = os.path.join(temp_dir, \"input_raw.wav\")\n    enhanced_wav = os.path.join(temp_dir, \"input_enhanced.wav\")\n\n    try:\n        # --- Step 1: extract audio to WAV at the input sample rate ---\n        print(f\"Step 1/3: Extracting audio ({sample_rate} Hz)...\")\n        extract_audio_wav(input_path, raw_wav, sample_rate)\n\n        # --- Step 2: enhance voice (isolated, degrades gracefully) ---\n        print(\"Step 2/3: Enhancing voice...\")\n        enhance_used = enhance_audio_isolated(raw_wav, enhanced_wav, sample_rate)\n\n        if enhance_used:\n            audio_for_norm = enhanced_wav\n        else:\n            print(\n                \"  Warning: voice enhancement backend ('pedalboard'/'noisereduce') \"\n                \"is not usable on this system;\",\n                file=sys.stderr,\n            )\n            print(\n                \"  falling back to the plain FFmpeg pipeline (noise reduction + \"\n                \"loudness normalization).\",\n                file=sys.stderr,\n            )\n            audio_for_norm = raw_wav\n\n        # --- Step 3, Pass 1: measure loudness of the audio to normalize ---\n        print(\"Step 3/3: Measuring loudness...\")\n        measured = measure_loudness(audio_for_norm, target_i, target_tp, target_lra)\n\n        input_i = measured[\"input_i\"]\n        input_tp = measured[\"input_tp\"]\n        input_lra = measured[\"input_lra\"]\n        input_thresh = measured[\"input_thresh\"]\n\n        # Estimate noise floor for better logging (works on both paths).\n        noise_floor = estimate_noise_floor(audio_for_norm)\n        if noise_floor is not None:\n            print(f\"  Estimated noise floor after enhancement: {noise_floor:.1f} dB RMS\")\n\n        # CRITICAL: offset MUST be 0 when using two-pass loudnorm with\n        # measured values (measured_I, measured_TP, etc.). The measured\n        # values already tell loudnorm exactly how much linear gain to\n        # apply to hit the target (-30.2 -> -14 = +16.2 dB).\n        # The 'offset' parameter is ADDITIONAL gain on TOP of that\n        # normalization, which would DOUBLE the required gain and\n        # drastically amplify the noise floor on quiet segments.\n        # Fix: offset=0 to avoid double-gain / noise amplification.\n        offset = 0.0\n        total_gain_lu = target_i - input_i\n\n        # Build the filter chain. When enhance ran, it already performed noise\n        # reduction (noisereduce + NoiseGate + HighPass), so afftdn is skipped\n        # to avoid double noise reduction. afftdn is only used on the fallback path.\n        filters = []\n        if not enhance_used and nr_amount > 0:\n            # On the fallback path: more aggressive afftdn + adaptive gate\n            # to suppress residual noise floor BEFORE loudnorm.\n            nr_val = max(nr_amount, 8)\n            # afftdn = adaptive frequency-domain noise reduction\n            filters.append(f\"afftdn=nr={nr_val}:tn=1\")\n            # agate = adaptive gate to keep noise floor down on quiet segments\n            # threshold at -36 dB, ratio 3:1, fast attack (1ms), slower release (150ms)\n            filters.append(\"agate=threshold=-36dB:ratio=3:attack=1:release=150\")\n\n        filters.append(\n            f\"loudnorm=I={target_i}:TP={target_tp}:LRA={target_lra}\"\n            f\":measured_I={input_i}:measured_TP={input_tp}\"\n            f\":measured_LRA={input_lra}:measured_thresh={input_thresh}\"\n            f\":offset={offset}:linear=true\"\n        )\n        # +2 dB gain (linear = 10^(2/20) ≈ 1.26) before true-peak limiter\n        filters.append(\"volume=1.26\")\n        # True-peak limiter at -1 dBTP (limit=0.995 ≈ -0.04 dBFS, combined with loudnorm TP=-1.0 gives ~-1 dBTP)\n        filters.append(\"alimiter=limit=0.995:attack=5:release=50:level=true\")\n\n        filter_desc = \",\".join(filters)\n\n        # Pass 2: apply filters to the (enhanced) audio and mux with copied video.\n        cmd = [\"ffmpeg\", \"-y\", \"-i\", input_path, \"-i\", audio_for_norm]\n\n        if video_present:\n            # Copy the video stream without re-encoding; take audio from the\n            # processed WAV (input 1).\n            cmd.extend([\"-map\", \"0:v:0\", \"-map\", \"1:a:0\", \"-c:v\", \"copy\"])\n        else:\n            cmd.extend([\"-map\", \"1:a:0\"])\n\n        # loudnorm internally works at 192 kHz, which would otherwise bump the\n        # encoded rate; pin the output rate to the input sample rate.\n        cmd.extend([\"-af\", filter_desc, \"-ar\", str(sample_rate)])\n        cmd.extend([\"-c:a\", \"aac\", \"-b:a\", \"192k\"])\n        cmd.append(output_path)\n\n        result = subprocess.run(cmd, capture_output=True, text=True)\n\n        if result.returncode != 0:\n            print(\"Error during normalization pass.\", file=sys.stderr)\n            lines = result.stderr.strip().splitlines()\n            for line in lines[-10:]:\n                print(line, file=sys.stderr)\n            sys.exit(1)\n\n        return input_i, total_gain_lu, enhance_used\n    finally:\n        # Always clean up temporary WAV files, even on error.\n        shutil.rmtree(temp_dir, ignore_errors=True)\n\n\ndef main():\n    parser = argparse.ArgumentParser(\n        description=(\n            \"Enhance and normalize audio of video/audio files: voice enhancement \"\n            \"(noisereduce + Pedalboard) followed by two-pass EBU R128 loudness \"\n            \"normalization to a target integrated loudness level (LUFS).\"\n        )\n    )\n    parser.add_argument(\"input\", help=\"Input video or audio file\")\n    parser.add_argument(\n        \"-o\", \"--output\",\n        help=\"Output file path (default: <input>_normalized<ext>)\",\n    )\n    parser.add_argument(\n        \"--target\",\n        type=float,\n        default=DEFAULT_TARGET,\n        help=f\"Target integrated loudness in LUFS (default: {DEFAULT_TARGET})\",\n    )\n    parser.add_argument(\n        \"--nr\",\n        type=float,\n        default=DEFAULT_NR,\n        help=(\n            f\"Noise reduction amount in dB using afftdn (0=off, default: {DEFAULT_NR}). \"\n            \"The enhance stage already performs noise reduction, so afftdn is \"\n            \"skipped on the normal path; this value is used only when the \"\n            \"enhance backend is unavailable.\"\n        ),\n    )\n\n    args = parser.parse_args()\n\n    check_ffmpeg()\n\n    input_path = args.input\n\n    if not os.path.isfile(input_path):\n        print(f\"Error: Input file not found: {input_path}\", file=sys.stderr)\n        sys.exit(1)\n\n    if not has_audio(input_path):\n        print(f\"Error: No audio stream found in: {input_path}\", file=sys.stderr)\n        sys.exit(1)\n\n    # Enhance voice is part of the defa...[truncated]"}}}
{"timestamp": "2026-10-04T05:37:06.730464+00:00", "task_id": "e57b9cedc8f240a38163011452f781d7", "event": "tool_result", "data": {"tool": "read_file", "tool_call_id": "call_01_6bqY0f7RKSEiPzrY7Sz36772", "success": true, "status": "success", "output": {"path": "routers/video_pipeline/index.py", "total_lines": 202, "content": "\"\"\"\nroutes/video_pipeline/index.py — Flask route for the Video Pipeline feature.\n\"\"\"\n\nimport json\nimport threading\nfrom flask import Blueprint, render_template, request, jsonify\nfrom includes.video_pipeline.processor import create_video\n\nvideo_pipeline_bp = Blueprint(\n    \"video_pipeline\",\n    __name__,\n    url_prefix=\"/video_pipeline\",\n)\n\n\n# ================================================================\n# In-memory state for the pipeline runner\n# ================================================================\n\ndef _to_bool(value, default: bool) -> bool:\n    \"\"\"Convert a form value to bool.\n\n    HTML checkbox: \"1\"/\"on\"/\"true\"/\"yes\" -> True, lainnya -> False.\n    Jika value None (field tidak dikirim), gunakan default.\n    \"\"\"\n    if value is None:\n        return default\n    return str(value).strip().lower() in (\"1\", \"true\", \"on\", \"yes\")\n\n\nclass PipelineRunner:\n    \"\"\"Manages the state of a video pipeline execution.\"\"\"\n\n    def __init__(self):\n        self.running = False\n        self.logs: list[str] = []\n        self.thread: threading.Thread | None = None\n\n    def add_log(self, text: str):\n        \"\"\"Add a log entry with timestamp and HTML formatting.\"\"\"\n        from datetime import datetime\n        now = datetime.now().strftime(\"%H:%M:%S\")\n\n        # Color based on content\n        level = \"info\"\n        if \"[OK]\" in text or \"berhasil\" in text.lower() or \"selesai\" in text.lower():\n            level = \"success\"\n        elif \"[FAIL]\" in text or \"[ERROR]\" in text or \"gagal\" in text.lower() or \"[SKIP]\" in text:\n            level = \"danger\"\n        elif \"[WARN]\" in text:\n            level = \"warning\"\n\n        colors = {\n            \"info\": \"#4dabf7\",\n            \"success\": \"#51cf66\",\n            \"warning\": \"#fcc419\",\n            \"danger\": \"#ff6b6b\",\n        }\n        icons = {\n            \"info\": \"\\U0001f5c8\\ufe0f\",\n            \"success\": \"\\u2705\",\n            \"warning\": \"\\u26a0\\ufe0f\",\n            \"danger\": \"\\u274c\",\n        }\n\n        color = colors.get(level, \"#ffffff\")\n        icon = icons.get(level, \"\\u2022\")\n        text_clean = text.replace(\"&\", \"&amp;\").replace(\"<\", \"&lt;\").replace(\">\", \"&gt;\")\n\n        html = (\n            f'<div style=\"line-height:1.25\">'\n            f'<span style=\"color:#666\">[{now}]</span> '\n            f'<span style=\"color:{color}\">{icon}</span> '\n            f'<span>{text_clean}</span>'\n            f'</div>'\n        )\n        self.logs.append(html)\n        if len(self.logs) > 500:\n            self.logs = self.logs[-500:]\n\n    def _run_pipeline(\n        self,\n        root_path: str,\n        preserve_audio: bool,\n        add_music: bool,\n        edit_audio_db: bool,\n        audio_db: float,\n    ):\n        \"\"\"Run the pipeline in a background thread.\"\"\"\n        try:\n            result = create_video(\n                root_path,\n                log_callback=self.add_log,\n                preserve_audio=preserve_audio,\n                add_music=add_music,\n                edit_audio_db=edit_audio_db,\n                audio_db=audio_db,\n            )\n            self.add_log(f\"Pipeline selesai: {result['succeeded']} OK, {result['failed']} FAIL\")\n        except Exception as e:\n            self.add_log(f\"[ERROR] Pipeline crash: {e}\")\n        finally:\n            self.running = False\n\n    def start(\n        self,\n        root_path: str,\n        preserve_audio: bool = False,\n        add_music: bool = True,\n        edit_audio_db: bool = False,\n        audio_db: float = 0.0,\n    ) -> bool:\n        \"\"\"Start the pipeline in a background thread.\"\"\"\n        if self.running:\n            return False\n\n        self.logs.clear()\n        self.running = True\n        self.thread = threading.Thread(\n            target=self._run_pipeline,\n            args=(root_path, preserve_audio, add_music, edit_audio_db, audio_db),\n            daemon=True,\n        )\n        self.thread.start()\n        return True\n\n    def status(self) -> dict:\n        \"\"\"Return current status as a dict.\"\"\"\n        return {\n            \"running\": self.running,\n            \"logs\": self.logs,\n        }\n\n\n# Singleton instance\npipeline_runner = PipelineRunner()\n\n\n# ================================================================\n# Routes\n# ================================================================\n\n@video_pipeline_bp.route(\"/\", methods=[\"GET\"])\ndef index():\n    \"\"\"Render the Video Pipeline page.\"\"\"\n    return render_template(\"video_pipeline/index.html\")\n\n\n@video_pipeline_bp.route(\"/start\", methods=[\"POST\"])\ndef start():\n    \"\"\"Start the video pipeline.\"\"\"\n    root_path = request.form.get(\"root_path\", \"\").strip()\n\n    # Opsi audio/music (default: preserve_audio=false, add_music=true)\n    preserve_audio = _to_bool(request.form.get(\"preserve_audio\"), default=False)\n    add_music = _to_bool(request.form.get(\"add_music\"), default=True)\n\n    # Edit Audio dB (default: off, audio_db=0)\n    edit_audio_db = _to_bool(request.form.get(\"edit_audio_db\"), default=False)\n    audio_db = 0.0\n    if edit_audio_db:\n        raw_db = request.form.get(\"audio_db\", \"\").strip()\n        if raw_db:\n            try:\n                audio_db = float(raw_db)\n            except (TypeError, ValueError):\n                return jsonify({\n                    \"success\": False,\n                    \"message\": \"Audio dB harus berupa angka (contoh: +5, -3, 0).\",\n                }), 400\n            if audio_db != audio_db or audio_db in (float(\"inf\"), float(\"-inf\")):\n                return jsonify({\n                    \"success\": False,\n                    \"message\": \"Audio dB harus berupa angka yang valid.\",\n                }), 400\n\n    if not root_path:\n        return jsonify({\"success\": False, \"message\": \"Root path tidak boleh kosong.\"}), 400\n\n    import os\n    if not os.path.isdir(root_path):\n        return jsonify({\"success\": False, \"message\": \"Path tidak ditemukan atau bukan folder.\"}), 400\n\n    ok = pipeline_runner.start(\n        root_path,\n        preserve_audio=preserve_audio,\n        add_music=add_music,\n        edit_audio_db=edit_audio_db,\n        audio_db=audio_db,\n    )\n\n    if not ok:\n        return jsonify({\"success\": False, \"message\": \"Pipeline sedang berjalan.\"}), 409\n\n    return jsonify({\"success\": True, \"message\": \"Pipeline dimulai.\"})\n\n\n@video_pipeline_bp.route(\"/status\", methods=[\"GET\"])\ndef status():\n    \"\"\"Return pipeline status and logs.\"\"\"\n    return jsonify(pipeline_runner.status())\n"}, "error": null}}
