ath\n    else:\n        _log(\"  Edit Audio dB: skip\")\n\n    # -- Step 2: Add Sound (hanya jika add_music=True) --\n    if add_music:\n        _log(\"  Add Sound...\")", "content_numbered": "440: \n441:     # -- Step 1: Decode/Reverse --\n442:     _log(\"  Decode/Reverse...\")\n443:     decode_output = decode_single_video(video_path, preserve_audio=preserve_audio)\n444:     if not decode_output:\n445:         _log(\"  [FAIL] Decode gagal\")\n446:         return False\n447:     _log(\"  [OK]\")\n448: \n449:     decode_path = Path(decode_output)\n450: \n451:     # a_2.mp4 dibuat oleh decode_single_video\n452:     a2_path = asset_dir / \"a_2.mp4\"\n453:     if a2_path.exists():\n454:         temp_files.append(str(a2_path.resolve()))\n455: \n456:     # decode_output (output.mp4) adalah hasil decode, ini temp\n457:     temp_files.append(str(decode_path.resolve()))\n458: \n459:     # -- Step 1b: Normalize Audio (opsional, default ON di UI) --\n460:     # Dijalankan per-file mp4 SEBELUM langkah berikutnya (edit audio dB /\n461:     # add sound), sehingga level/dynamic range tiap file konsisten sebelum\n462:     # digabungkan.\n463:     if normalize_audio:\n464:         _log(\"  Normalize Audio...\")\n465:         normalized_path = _normalize_audio_step(decode_path, log_callback)\n466:         if normalized_path is not None:\n467:             temp_files.append(str(normalized_path.resolve()))\n468:             decode_path = normalized_path\n469:             _log(f\"  [OK] Normalize audio: {decode_path.name}\")\n470:     else:\n471:         _log(\"  Normalize Audio: skip\")\n472: \n473:     # -- Step 1c: Edit Audio dB (opsional, hanya aktif jika checkbox ON) --\n474:     if edit_audio_db and audio_db != 0:\n475:         _log(f\"  Edit Audio dB: {audio_db:g} dB\")\n476:         adjusted_path = _adjust_audio_db(decode_path, audio_db, log_callback)\n477:         if adjusted_path != decode_path:\n478:             temp_files.append(str(adjusted_path.resolve()))\n479:            